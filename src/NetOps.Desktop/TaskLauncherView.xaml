<UserControl x:Class="NetOps.Desktop.TaskLauncherView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,12">
      <DockPanel Margin="0,0,0,18">
        <Button DockPanel.Dock="Right" Content="不确定怎么操作？" Command="{Binding ToggleHelp}" Style="{StaticResource Quiet}" />
        <StackPanel><TextBlock Text="选择这次要做的一件事" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="每次只填写相关内容，按下一步操作；确认之前不会修改交换机。" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel>
      </DockPanel>
      <TextBlock Text="修改端口" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
      <UniformGrid Columns="3">
        <Button Style="{StaticResource TaskAction}" Command="{Binding StartEasy}" CommandParameter="PortName" Background="#EFF5FF" BorderBrush="#C5D7FA"><StackPanel><TextBlock Text="给端口改个名字" FontSize="18" FontWeight="SemiBold" Foreground="#1D4ED8" /><TextBlock Text="例如改成“财务室打印机”，不改变网络。" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel></Button>
        <Button Style="{StaticResource TaskAction}" Command="{Binding StartEasy}" CommandParameter="PortNetwork"><StackPanel><TextBlock Text="更换端口所属网络" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="把电脑或打印机接入口改到另一个 VLAN。" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel></Button>
        <Button Style="{StaticResource TaskAction}" Command="{Binding StartEasy}" CommandParameter="PortPower"><StackPanel><TextBlock Text="打开或关闭端口" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="让某个网线插口允许联网或停止联网。" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel></Button>
      </UniformGrid>
      <TextBlock Text="管理端口允许接入的设备" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10" />
      <UniformGrid Columns="3">
        <Button Style="{StaticResource TaskAction}" Command="{Binding StartEasy}" CommandParameter="AddMac"><StackPanel><TextBlock Text="给端口绑定设备" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="填写网卡地址 MAC，可以一次添加多条。" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel></Button>
        <Button Style="{StaticResource TaskAction}" Command="{Binding StartEasy}" CommandParameter="ReplaceMac"><StackPanel><TextBlock Text="更换已绑定的设备" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="例如更换了一台电脑，用新地址替换旧地址。" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel></Button>
        <Button Style="{StaticResource TaskAction}" Command="{Binding StartEasy}" CommandParameter="RemoveMac"><StackPanel><TextBlock Text="取消设备绑定" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="选择不再使用的旧地址，核对后解除限制。" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel></Button>
      </UniformGrid>
      <TextBlock Text="网络和配置文件" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10" />
      <UniformGrid Columns="4">
        <Button Style="{StaticResource TaskAction}" Command="{Binding StartEasy}" CommandParameter="CreateNetwork"><StackPanel><TextBlock Text="创建网络" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="添加一个 VLAN 编号。" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel></Button>
        <Button Style="{StaticResource TaskAction}" Command="{Binding StartEasy}" CommandParameter="RenameNetwork"><StackPanel><TextBlock Text="修改网络名称" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="给已有 VLAN 改名字。" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel></Button>
        <Button Style="{StaticResource TaskAction}" Command="{Binding StartEasy}" CommandParameter="DeleteNetwork"><StackPanel><TextBlock Text="删除网络" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="只能删除不再使用的 VLAN。" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel></Button>
        <Button Style="{StaticResource TaskAction}" Command="{Binding StartEasy}" CommandParameter="Backup"><StackPanel><TextBlock Text="备份配置" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="保留当前设置的副本。" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel></Button>
      </UniformGrid>
      <WrapPanel Margin="0,8,0,14"><Button Content="查看这台交换机的运行状态" Command="{Binding ChooseTask}" CommandParameter="0" /><Button Content="查看备份与操作记录" Command="{Binding ChooseTask}" CommandParameter="3" /></WrapPanel>
      <Expander Header="高级功能 · 完整配置、命令、AI 和批量草稿" Foreground="#64748B">
        <StackPanel Margin="0,12,0,0"><TextBlock Text="这些功能保留完整的网络配置选项；普通改名、换网络和设备绑定请使用上方分步操作。" Style="{StaticResource MutedText}" Margin="0,0,0,12" /><WrapPanel><Button Content="完整端口设置" Command="{Binding ChooseTask}" CommandParameter="1" /><Button Content="VLAN 列表与成员矩阵" Command="{Binding ChooseTask}" CommandParameter="2" /><Button Content="高级 MAC / 静态转发" Command="{Binding ChooseTask}" CommandParameter="6" /><Button Content="手动命令终端" Command="{Binding ChooseTask}" CommandParameter="4" /><Button Content="AI 辅助分析" Command="{Binding ToggleAi}" /><Button Content="批量草稿" Command="{Binding OpenDeviceQueue}" /></WrapPanel></StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
