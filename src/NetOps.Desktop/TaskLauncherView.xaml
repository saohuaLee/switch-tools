<UserControl x:Class="NetOps.Desktop.TaskLauncherView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Margin="0" Padding="14">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <TextBlock Text="{Binding WorkListCaption}" FontSize="18" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,10,0,8"><TextBlock Text="搜索端口号、名称或网络编号" Style="{StaticResource MutedText}" FontSize="12" /><TextBox Text="{Binding WorkSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索端口" Margin="0,6,0,0" /></StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding WorkPorts}" SelectedItem="{Binding WorkPort}" IsEnabled="{Binding WorkCanSelect}" RowHeight="65" SelectionMode="Single" HeadersVisibility="None">
          <DataGrid.Columns><DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State.Pvid, StringFormat=网络 {0}}" Foreground="#64748B" FontSize="11" /><TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" /></DockPanel><TextBlock Text="{Binding State.Description}" Margin="0,3,0,0" /><TextBlock Text="{Binding State.Name}" FontSize="10" Foreground="#8792A5" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="18">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding WorkPortTitle}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding WorkPortCaption}" Foreground="#64748B" Margin="0,6,0,0" />
          <Border Background="#EFF5FF" Padding="12" CornerRadius="6" Margin="0,12,0,0" Visibility="{Binding WorkNeedsRead, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="先读取交换机的当前端口，才能修改。读取不会改变配置。" /><Button Content="连接并读取端口" Command="{Binding ReadCurrent}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,10,0,0" /></StackPanel></Border>
          <TextBlock Text="{Binding WorkNotice}" Foreground="{Binding WorkNoticeColor}" FontSize="14" Margin="0,12,0,0" Visibility="{Binding WorkHasNotice, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
        <TabControl Grid.Row="1" SelectedIndex="{Binding WorkTab}" Style="{StaticResource WorkspaceTabs}" IsEnabled="{Binding WorkCanEdit}" Visibility="{Binding WorkHasPort, Converter={StaticResource BoolVisibility}}">
          <TabItem Header="端口信息"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
            <TextBlock Text="名称 / 说明" FontWeight="SemiBold" /><TextBox Text="{Binding WorkName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="端口名称" MaxLength="128" /><TextBlock Text="例如：财务室打印机。留空表示清除名称。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,18" />
            <TextBlock Text="所属网络（VLAN）" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding EasyNetworks}" SelectedItem="{Binding WorkNetwork}" DisplayMemberPath="Label" AutomationProperties.Name="端口所属网络" Visibility="{Binding WorkNewNetwork, Converter={StaticResource InverseVisibility}}" />
            <CheckBox Content="列表中没有，我要填写新的网络编号" IsChecked="{Binding WorkNewNetwork}" Margin="0,8,0,8" /><TextBox Text="{Binding WorkNetworkNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新网络编号" Visibility="{Binding WorkNewNetwork, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="修改网络会一起保留已有静态安全绑定，可能短暂断网；终端可能需要重新获取 IP。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,18" />
            <CheckBox Content="打开这个端口，允许网线连接的设备联网" IsChecked="{Binding WorkEnabled}" /><TextBlock Text="取消勾选会关闭插口，连接在上面的设备将断网。" Style="{StaticResource MutedText}" FontSize="12" />
          </StackPanel></ScrollViewer></TabItem>
          <TabItem Header="MAC 绑定名单"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
            <TextBlock Text="勾选要继续保留的旧地址，再填写新地址。只会在确认应用后修改交换机。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,10" />
            <TextBlock Text="此端口暂不支持普通 MAC 接入限制。需要已适配的 Cisco 接入口；静态转发请使用高级功能。" Foreground="#9A650D" Visibility="{Binding WorkMacSupported, Converter={StaticResource InverseVisibility}}" Margin="0,0,0,10" />
            <StackPanel IsEnabled="{Binding WorkMacSupported}">
              <DockPanel Margin="0,0,0,8"><TextBlock Text="{Binding WorkOriginalMacHeading}" FontWeight="SemiBold" /><Button Content="全部保留" Command="{Binding KeepAllWorkMacs}" Style="{StaticResource Quiet}" Padding="6,2" MinHeight="24" Margin="8,0,0,0" /><Button Content="只用下面的新地址" Command="{Binding ReplaceAllWorkMacs}" Style="{StaticResource Quiet}" Padding="6,2" MinHeight="24" Margin="4,0,0,0" /></DockPanel>
              <TextBlock Text="没有原有静态安全绑定。" Foreground="#64748B" Visibility="{Binding WorkNoExistingMacs, Converter={StaticResource BoolVisibility}}" />
              <ItemsControl ItemsSource="{Binding WorkExistingMacs}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F4F7FB" CornerRadius="5" Padding="10,8" Margin="0,0,0,5"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Disposition}" Foreground="#64748B" /><CheckBox IsChecked="{Binding Keep, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Address}" FontFamily="Consolas" Margin="0" /></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <DockPanel Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="整理格式" Command="{Binding FormatWorkMacs}" Style="{StaticResource Quiet}" Padding="6,2" MinHeight="24" Margin="0" /><TextBlock Text="新增地址（每行一个，可以粘贴多条）" FontWeight="SemiBold" /></DockPanel>
              <TextBox Text="{Binding WorkAddresses, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新增MAC地址" AcceptsReturn="True" Height="86" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
              <TextBlock Text="支持 38-ff-59-06-1a-71、38:ff:59:06:1a:71、38ff.5906.1a71；重复地址会合并。" Style="{StaticResource MutedText}" FontSize="11" />

              <CheckBox Content="按最终名单自动设置允许数量（推荐）" IsChecked="{Binding WorkAutomaticMaximum}" />
              <DockPanel Visibility="{Binding WorkManualMaximum, Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="按名单自动设置" Command="{Binding AutomaticWorkMaximum}" Style="{StaticResource Quiet}" Margin="10,6,0,12" /><TextBox Text="{Binding WorkMaximum, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="自定义允许设备数量" /></DockPanel>
              <TextBlock Text="出现名单外的设备时" FontWeight="SemiBold" Margin="0,12,0,0" /><ComboBox ItemsSource="{Binding MacViolations}" SelectedItem="{Binding WorkViolation}" DisplayMemberPath="Label" AutomationProperties.Name="违规动作" />
              <TextBlock Text="{Binding WorkCurrentRule}" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="绑定操作会先关闭端口，完成后打开并保存。自定义数量大于名单时，空位可能被其他地址动态学习。" Foreground="#9A650D" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>
          </StackPanel></ScrollViewer></TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0" Visibility="{Binding WorkHasPort, Converter={StaticResource BoolVisibility}}"><StackPanel>
          <Border Background="#EFF5FF" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="{Binding WorkEditingMac, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding WorkMacSummary}" Foreground="#1D4ED8" FontWeight="SemiBold" /><TextBlock Text="{Binding WorkLimitSummary}" Margin="0,6,0,0" /><Button x:Name="FixedMacMaximumButton" Content="按名单自动设置" Command="{Binding AutomaticWorkMaximum}" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Padding="0,4" MinHeight="26" Margin="0,4,0,0" Visibility="{Binding WorkManualMaximum, Converter={StaticResource BoolVisibility}}" /></StackPanel></Border><TextBlock Text="{Binding WorkError}" Foreground="#B42332" Margin="0,0,0,10" Visibility="{Binding WorkHasError, Converter={StaticResource BoolVisibility}}" />
          <DockPanel><Button x:Name="ApplyPortFormButton" DockPanel.Dock="Right" Content="检查并应用本页修改" Command="{Binding ReviewWorkPort}" Style="{StaticResource Primary}" Margin="10,0,0,0" /><Button DockPanel.Dock="Right" Content="还原填写" Command="{Binding ResetWorkPort}" Margin="0" /><TextBlock Text="只应用右侧当前这一页，确认前不会下发。" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" /></DockPanel>
        </StackPanel></Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
