<Window x:Class="NetOps.Desktop.AddDeviceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设备与连接配置" Style="{StaticResource {x:Type Window}}" Width="750" Height="800" MinHeight="620" MinWidth="650" WindowStartupLocation="CenterOwner" Language="zh-CN">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="DialogHeading" Text="添加设备与连接" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="先登记设备，再选择连接方式；保存不会自动连接或下发配置。" Style="{StaticResource MutedText}" Margin="0,6,0,14"/></StackPanel>
    <TabControl Grid.Row="1"><TabItem Header="设备资料"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,8,12,0">
      <TextBlock Text="设备名称 *"/><TextBox x:Name="DeviceName" AutomationProperties.Name="设备名称"/><TextBlock Text="管理 IP（纯 Console 设备可留空）"/><TextBox x:Name="DeviceIp" AutomationProperties.Name="管理 IP 地址"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="厂商"/><ComboBox x:Name="VendorBox" DisplayMemberPath="Label"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="设备角色"/><ComboBox x:Name="RoleBox" DisplayMemberPath="Label"/></StackPanel></Grid>
      <TextBlock Text="设备型号"/><TextBox x:Name="ModelBox"/><TextBlock Text="系统 / 固件版本"/><TextBox x:Name="FirmwareBox"/><TextBlock Text="位置 / 分组"/><TextBox x:Name="LocationBox"/><TextBlock Text="管理 VLAN（用于风险检查）"/><TextBox x:Name="ManagementVlanBox" Text="1"/><CheckBox x:Name="SimulationBox" Content="模拟设备（仅本地演练）" IsChecked="True"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="连接配置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,8,12,0">
      <TextBlock Text="已有连接（一个设备可保存多个配置）"/><DockPanel><Button DockPanel.Dock="Right" Content="新增连接" Click="NewConnectionClick" Margin="8,5,0,10"/><ComboBox x:Name="ConnectionBox" DisplayMemberPath="Label" SelectionChanged="ConnectionChanged"/></DockPanel>
      <TextBlock Text="连接名称 *"/><TextBox x:Name="ConnectionName"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="连接方式"/><ComboBox x:Name="ProtocolBox" DisplayMemberPath="Label" SelectionChanged="ProtocolChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="网络端口"/><TextBox x:Name="NetworkPortBox" Text="22"/></StackPanel></Grid>
      <StackPanel x:Name="SerialOptions" Visibility="Collapsed"><TextBlock Text="串口名称（可手填）"/><ComboBox x:Name="SerialPortBox" IsEditable="True"/><TextBlock Text="波特率 / 数据位"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="BaudBox" Text="9600"/><TextBox Grid.Column="2" x:Name="DataBitsBox" Text="8"/></Grid><TextBlock Text="校验 / 停止位 / 流控"/><WrapPanel><ComboBox x:Name="ParityBox" Width="160" Margin="0,5,10,10"/><ComboBox x:Name="StopBitsBox" Width="150" Margin="0,5,10,10"/><ComboBox x:Name="FlowBox" Width="180"/></WrapPanel></StackPanel>
      <StackPanel x:Name="ApiOptions" Visibility="Collapsed"><TextBlock Text="只读 API 完整地址（RESTCONF 需包含资源路径）"/><TextBox x:Name="EndpointBox" ToolTip="例如 https://设备地址/restconf/data/ietf-interfaces:interfaces"/></StackPanel>
      <StackPanel x:Name="CredentialsOptions"><TextBlock Text="用户名（HTTP 留空时以令牌认证）"/><TextBox x:Name="UsernameBox"/><TextBlock Text="密码 / API 令牌 / 私钥口令（留空保留原凭据）"/><PasswordBox x:Name="PasswordBox"/><StackPanel x:Name="FingerprintOptions"><TextBlock Text="可信 SSH SHA256 指纹 *（须通过带外渠道核对）"/><TextBox x:Name="FingerprintBox"/><DockPanel><Button DockPanel.Dock="Left" Content="导入 SSH 私钥" Click="ImportKeyClick"/><TextBlock x:Name="KeyLabel" Text="未导入新私钥；已有凭据留空保留" Style="{StaticResource MutedText}" FontSize="12"/></DockPanel></StackPanel></StackPanel>
      <CheckBox x:Name="AllowTelnetBox" Content="允许明文 Telnet，仅用于可信管理网络" Visibility="Collapsed"/>
      <TextBlock Text="Console / Telnet 的登录提示由高级终端处理。NETCONF 目前提供 get-config；RESTCONF / 厂商 API 目前仅发送 GET。所有协议保留系统证书或主机指纹校验。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,14,0,8"/>
    </StackPanel></ScrollViewer></TabItem></TabControl>
    <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="ErrorText" Foreground="#F2B38E" Margin="0,0,0,10"/><WrapPanel HorizontalAlignment="Right"><Button Content="取消" IsCancel="True"/><Button Content="保存设备与连接" Click="SaveClick" Style="{StaticResource Primary}" Margin="0"/></WrapPanel></StackPanel>
  </Grid>
</Window>
