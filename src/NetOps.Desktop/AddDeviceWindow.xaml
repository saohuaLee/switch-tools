<Window x:Class="NetOps.Desktop.AddDeviceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="添加交换机" Style="{StaticResource {x:Type Window}}" Width="760" Height="800" MinHeight="560" MinWidth="650" WindowStartupLocation="CenterOwner" Language="zh-CN">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock x:Name="DialogHeading" Text="添加一台交换机" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="填写设备资料和登录账户，保存后即可进入端口设置。" Style="{StaticResource MutedText}" Margin="0,9,0,0" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="设备名称" FontWeight="SemiBold" /><TextBox x:Name="DeviceName" AutomationProperties.Name="设备名称" /><TextBlock Text="例如：办公室交换机" Style="{StaticResource MutedText}" FontSize="12" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="交换机管理地址（IP）" FontWeight="SemiBold" /><TextBox x:Name="DeviceIp" AutomationProperties.Name="管理 IP 地址" /><TextBlock Text="例如：192.168.1.2，请向管理员获取" Style="{StaticResource MutedText}" FontSize="12" /></StackPanel></Grid>
        <TextBlock Text="设备厂商（查看设备上的品牌）" Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold" /><ComboBox x:Name="VendorBox" DisplayMemberPath="Label" />
        <CheckBox x:Name="SimulationBox" Content="我想先练习，不连接真实设备" IsChecked="False" Checked="SimulationChanged" Unchecked="SimulationChanged" Margin="0,14,0,10" />
        <TextBlock Text="交换机登录账户" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="通常使用网络连接（SSH）。请填写交换机的管理账户，不是电脑或 Wi-Fi 账户。密码仅加密保存在本机。" Style="{StaticResource MutedText}" Margin="0,6,0,12" />
        <StackPanel x:Name="CredentialsOptions"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="登录用户名" /><TextBox x:Name="UsernameBox" AutomationProperties.Name="交换机登录用户名" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="登录密码（编辑时留空保留）" /><PasswordBox x:Name="PasswordBox" AutomationProperties.Name="交换机登录密码" /></StackPanel></Grid><StackPanel x:Name="FingerprintOptions"><TextBlock Text="设备身份码（SSH 指纹）" FontWeight="SemiBold" /><TextBox x:Name="FingerprintBox" AutomationProperties.Name="可信SSH设备指纹" /><TextBlock Text="向管理员获取以 SHA256: 开头的指纹，用来确认连接的是正确交换机。" Style="{StaticResource MutedText}" FontSize="12" /></StackPanel></StackPanel>
        <Expander Header="选填：位置、型号及其他设备资料" Margin="0,18,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="位置 / 分组" /><TextBox x:Name="LocationBox" /><TextBlock Text="设备型号" /><TextBox x:Name="ModelBox" /><TextBlock Text="系统 / 固件版本" /><TextBox x:Name="FirmwareBox" /><TextBlock Text="设备角色" /><ComboBox x:Name="RoleBox" DisplayMemberPath="Label" /><TextBlock Text="管理网络编号（用于检查是否影响管理连接）" /><TextBox x:Name="ManagementVlanBox" Text="1" /></StackPanel></Expander>
        <Expander Header="其他连接方式 / 高级连接选项" Margin="0,18,0,0"><StackPanel Margin="0,12,0,0">
          <TextBlock Text="已有连接配置" /><DockPanel><Button DockPanel.Dock="Right" Content="添加另一套连接" Click="NewConnectionClick" Margin="8,6,0,12" /><ComboBox x:Name="ConnectionBox" DisplayMemberPath="Label" SelectionChanged="ConnectionChanged" /></DockPanel><TextBlock Text="连接名称" /><TextBox x:Name="ConnectionName" /><TextBlock Text="连接方式" /><ComboBox x:Name="ProtocolBox" DisplayMemberPath="Label" SelectionChanged="ProtocolChanged" /><TextBlock Text="网络端口（SSH 通常是 22）" /><TextBox x:Name="NetworkPortBox" Text="22" />
          <DockPanel><Button DockPanel.Dock="Left" Content="导入 SSH 私钥" Click="ImportKeyClick" /><TextBlock x:Name="KeyLabel" Text="没有私钥时可使用用户名和密码" Style="{StaticResource MutedText}" FontSize="12" /></DockPanel>
          <StackPanel x:Name="SerialOptions" Visibility="Collapsed"><TextBlock Text="串口名称" /><ComboBox x:Name="SerialPortBox" IsEditable="True" /><TextBlock Text="波特率 / 数据位" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBox x:Name="BaudBox" Text="9600" /><TextBox Grid.Column="2" x:Name="DataBitsBox" Text="8" /></Grid><TextBlock Text="校验 / 停止位 / 流控" /><WrapPanel><ComboBox x:Name="ParityBox" Width="160" Margin="0,5,10,10" /><ComboBox x:Name="StopBitsBox" Width="150" Margin="0,5,10,10" /><ComboBox x:Name="FlowBox" Width="180" /></WrapPanel></StackPanel>
          <StackPanel x:Name="ApiOptions" Visibility="Collapsed"><TextBlock Text="只读 API 完整地址" /><TextBox x:Name="EndpointBox" /><TextBlock Text="HTTP API 使用用户名和密码；用户名留空时将密码栏视为访问令牌。" Style="{StaticResource MutedText}" /></StackPanel>
          <CheckBox x:Name="AllowTelnetBox" Content="允许明文 Telnet，仅用于可信管理网络" Visibility="Collapsed" /><TextBlock Text="串口和 Telnet 需要到手动终端登录；API 仅提供只读能力，不能代替已适配 SSH 图形化配置。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" />
        </StackPanel></Expander>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="ErrorText" Foreground="#B42332" TextWrapping="Wrap" Margin="0,0,0,10" /><DockPanel><Button DockPanel.Dock="Left" Content="取消" IsCancel="True" /><Button x:Name="SaveDeviceButton" Content="保存，进入端口设置" Click="SaveClick" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0" /></DockPanel></StackPanel>
  </Grid>
</Window>
