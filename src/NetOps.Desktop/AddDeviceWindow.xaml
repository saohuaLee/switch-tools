<Window x:Class="NetOps.Desktop.AddDeviceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="添加设备档案" Style="{StaticResource {x:Type Window}}" Width="620" Height="800" MinHeight="600" WindowStartupLocation="CenterOwner" Language="zh-CN">
  <DockPanel Margin="24"><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="ErrorText" Foreground="#F0AC91" Margin="0,6,0,12" /><Button Content="保存设备档案" Click="SaveClick" Style="{StaticResource Primary}" HorizontalAlignment="Right" /></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="添加设备档案" FontSize="24" FontWeight="Bold" Margin="0,0,0,8" /><TextBlock Text="只保存档案，不会自动扫描或连接设备。真实设备配置写入尚未开放。" Style="{StaticResource MutedText}" Margin="0,0,0,18" />
    <TextBlock Text="设备名称" /><TextBox x:Name="DeviceName" AutomationProperties.Name="设备名称" />
    <TextBlock Text="管理 IP 地址" /><TextBox x:Name="DeviceIp" Text="192.0.2.40" AutomationProperties.Name="管理 IP 地址" />
    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="厂商" /><ComboBox x:Name="VendorBox" DisplayMemberPath="Label" SelectedIndex="0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="设备角色" /><ComboBox x:Name="RoleBox" DisplayMemberPath="Label" SelectedIndex="0" /></StackPanel></Grid>
    <TextBlock Text="型号 / 系统版本（按铭牌或设备信息填写）" /><TextBox x:Name="ModelBox" /><TextBox x:Name="FirmwareBox" />
    <TextBlock Text="位置 / 分组" /><TextBox x:Name="LocationBox" />
    <CheckBox x:Name="SimulationBox" Content="作为模拟设备，仅用于本地演练" IsChecked="True" />
    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="管理 VLAN" /><TextBox x:Name="ManagementVlanBox" Text="99" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SSH 端口" /><TextBox x:Name="SshPortBox" Text="22" /></StackPanel></Grid>
    <TextBlock Text="以下仅用于真实设备，只支持密码认证" Foreground="{StaticResource Accent}" Margin="0,10,0,10" /><TextBlock Text="登录用户名" /><TextBox x:Name="UsernameBox" /><TextBlock Text="登录密码（加密保存，不写入设备记录）" /><PasswordBox x:Name="PasswordBox" />
    <TextBlock Text="可信主机指纹（SHA256:…，须从带外可信渠道核对）" /><TextBox x:Name="FingerprintBox" />
  </StackPanel></ScrollViewer></DockPanel>
</Window>
