<Window x:Class="NetOps.Desktop.DiscoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="发现网络端点" Style="{StaticResource {x:Type Window}}" Width="820" Height="630" MinWidth="720" MinHeight="550" WindowStartupLocation="CenterOwner">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="批量查找管理地址（高级）" Style="{StaticResource SectionTitle}"/><TextBlock Text="填写地址范围 → 开始查找 → 勾选结果 → 添加到设备清单。最多检查 256 个地址，不会自动登录。找到可访问地址不代表它一定是交换机，请核对后再添加。" Style="{StaticResource MutedText}" Margin="0,0,0,12"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="85"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="起始 IPv4"/><TextBox x:Name="StartAddress" AutomationProperties.Name="发现起始 IPv4"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="结束 IPv4"/><TextBox x:Name="EndAddress" AutomationProperties.Name="发现结束 IPv4"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="TCP 端口"/><TextBox x:Name="TcpPort" Text="22" AutomationProperties.Name="发现 TCP 端口"/></StackPanel><StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,10"><Button x:Name="StartButton" Content="开始发现" Click="StartClick" Style="{StaticResource Primary}"/><Button x:Name="CancelButton" Content="取消" Click="CancelClick" IsEnabled="False" Margin="0"/></StackPanel></Grid>
    <DataGrid Grid.Row="2" x:Name="ResultsGrid" Margin="0,4,0,12"><DataGrid.Columns><DataGridTemplateColumn Header="导入" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Picked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="可达地址" Binding="{Binding Endpoint.Address}" Width="*"/><DataGridTextColumn Header="TCP 端口" Binding="{Binding Endpoint.Port}" Width="100"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3"><TextBlock x:Name="StatusText" Text="填写明确范围，点击开始后才检查网络。" Style="{StaticResource MutedText}" Margin="0,0,0,12"/><WrapPanel><TextBlock Text="建档厂商" VerticalAlignment="Center" Margin="0,0,8,8"/><ComboBox x:Name="VendorBox" Width="120" DisplayMemberPath="Label" Margin="0,0,12,8"/><Button x:Name="ImportButton" Content="导入勾选端点为真实设备" Click="ImportClick" IsEnabled="False" Style="{StaticResource Primary}" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="导入后默认建立 SSH 连接配置，需在设备设置填写凭据与可信指纹；不会自动连接。" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel>
  </Grid>
</Window>
