<UserControl x:Class="NetOps.Desktop.WorkReviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="White" CornerRadius="10" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="确认这次修改" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{Binding EasyDeviceCaption}" Style="{StaticResource MutedText}" Margin="0,8,0,12" /><Border Background="#EFF5FF" CornerRadius="6" Padding="14"><TextBlock Text="{Binding WorkReviewSummary}" FontSize="16" FontWeight="SemiBold" /></Border></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
      <ItemsControl ItemsSource="{Binding WorkReviewRows}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#DDE5F0" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel><TextBlock Text="{Binding Object}" FontWeight="SemiBold" /><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="现在" Foreground="#64748B" Margin="0,0,0,6" /><TextBlock Text="{Binding Before}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="应用后" Foreground="#2563EB" Margin="0,0,0,6" /><TextBlock Text="{Binding After}" Foreground="#1D4ED8" /></StackPanel></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{Binding PlanRisks}" Foreground="#9A650D" Margin="0,14,0,16" /><Expander Header="查看英文命令和中文解释（可选）"><DataGrid ItemsSource="{Binding PlanCommandRows}" MaxHeight="240" RowHeight="NaN"><DataGrid.Columns><DataGridTextColumn Header="英文命令" Binding="{Binding Command, Mode=OneWay}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontFamily" Value="Consolas" /><Setter Property="Margin" Value="8" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="中文解释" Binding="{Binding Explanation, Mode=OneWay}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="8" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Expander>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><CheckBox x:Name="WorkConfirmation" Content="我已核对上面的改动" IsChecked="{Binding PlanConfirmed}" /><CheckBox Content="真实设备：我已确认中断影响及恢复途径" IsChecked="{Binding LiveRiskAccepted}" Visibility="{Binding IsLivePlan, Converter={StaticResource BoolVisibility}}" /><TextBlock Text="{Binding Operation}" Foreground="#2563EB" Margin="0,5,0,5" /><DockPanel><Button DockPanel.Dock="Right" Content="确认应用并保存" Command="{Binding ApplyPlan}" Style="{StaticResource Primary}" Margin="12,0,0,0" /><Button DockPanel.Dock="Right" Content="返回修改" Command="{Binding CloseReview}" Margin="0" /><TextBlock Text="先备份，再执行和检查，通过后保存。" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" /></DockPanel></StackPanel>
  </Grid></Border>
</UserControl>
