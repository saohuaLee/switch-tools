<Window x:Class="NetOps.Desktop.ManualLinkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="添加手工拓扑连接" Style="{StaticResource {x:Type Window}}" Width="650" Height="520" WindowStartupLocation="CenterOwner">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="添加手工连接" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="用于补充未发现的物理关系，拓扑中标记为手工、未校验。" Style="{StaticResource MutedText}" Margin="0,8,0,20"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本端设备"/><ComboBox x:Name="LocalDevice" DisplayMemberPath="Name" SelectionChanged="LocalChanged"/><TextBlock Text="本端端口"/><ComboBox x:Name="LocalPort" IsEditable="True"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="对端设备"/><ComboBox x:Name="RemoteDevice" DisplayMemberPath="Name" SelectionChanged="RemoteChanged"/><TextBlock Text="对端端口"/><ComboBox x:Name="RemotePort" IsEditable="True"/></StackPanel></Grid>
    <StackPanel Grid.Row="2"><TextBlock x:Name="ErrorText" Foreground="#BE123C" Margin="0,0,0,12"/><WrapPanel HorizontalAlignment="Right"><Button Content="取消" Click="CancelClick"/><Button Content="保存拓扑连接" Click="SaveClick" Style="{StaticResource Primary}" Margin="0"/></WrapPanel></StackPanel>
  </Grid>
</Window>
