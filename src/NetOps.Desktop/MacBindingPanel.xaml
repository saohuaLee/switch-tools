<UserControl x:Class="NetOps.Desktop.MacBindingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
          <WrapPanel>
            <StackPanel Width="290" Margin="0,0,24,0"><TextBlock Text="1  选择目标端口" FontSize="15" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding PortNames}" SelectedItem="{Binding MacPastePort}" AutomationProperties.Name="MAC 目标端口" Margin="0,9,0,0" /></StackPanel>
            <StackPanel Width="280"><TextBlock Text="绑定用途" Foreground="#64748B" /><ComboBox ItemsSource="{Binding MacKinds}" SelectedItem="{Binding SelectedMacKind}" DisplayMemberPath="Label" AutomationProperties.Name="MAC 绑定用途" Margin="0,9,0,0" /></StackPanel>
          </WrapPanel>
        </Border>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="16" Margin="0">
            <StackPanel>
              <TextBlock Text="当前端口的已有绑定" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
              <DataGrid ItemsSource="{Binding MacVisibleBindings}" Height="150" RowHeight="40">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="选择" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Picked, UpdateSourceTrigger=PropertyChanged}" Margin="0" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="已绑定 MAC" Binding="{Binding Binding.Address}" Width="165" />
                  <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="上限" Binding="{Binding MaximumLabel}" Width="60" />
                  <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="违规动作" Binding="{Binding ViolationLabel}" Width="220" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="这个端口还没有当前用途的绑定，可在右侧填写新 MAC。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" Visibility="{Binding HasMacVisibleBindings, Converter={StaticResource InverseVisibility}}" />
              <WrapPanel Margin="0,10,0,0"><Button Content="更换 / 调整所选" Command="{Binding EditSelectedMac}" Click="EditSelectedMacClick" /><Button Content="删除所选（先审核）" Command="{Binding ReviewDeleteMacOperation}" Style="{StaticResource Quiet}" /></WrapPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="0">
            <Grid>
            <StackPanel Visibility="{Binding HasMacReplacements, Converter={StaticResource InverseVisibility}}">
              <TextBlock Text="2  输入要绑定的 MAC 地址" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="每行一个，可粘贴多条；横线、冒号、点号都能识别。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,8" />
              <TextBox Text="{Binding MacPasteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="输入一条或多条 MAC 地址" FontFamily="Consolas" />
              <TextBlock Text="例如 38-ff-59-06-1a-71，下发自动转为 38ff.5906.1a71。" Style="{StaticResource MutedText}" FontSize="11" />
              <Button Content="整理到下方列表（可选）" Command="{Binding ImportMacRows}" HorizontalAlignment="Left" Margin="0,10,0,0" />
            </StackPanel>
            <StackPanel Visibility="{Binding HasMacReplacements, Converter={StaticResource BoolVisibility}}"><TextBlock Text="2  更换已有绑定" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="旧地址已带入下方列表。请直接修改“新 MAC”这一列，再点击右下角“下一步”。" Foreground="#1D4ED8" Margin="0,14,0,0" /><TextBlock Text="原 MAC 为只读，用于生成删除旧绑定的命令；新 MAC 用于重新绑定。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" /></StackPanel>
            </Grid>
          </Border>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12" Visibility="{Binding HasMacRows, Converter={StaticResource BoolVisibility}}">
          <StackPanel>
            <DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="添加一行" Command="{Binding AddMacRow}" Style="{StaticResource Quiet}" /><Button Content="整理格式" Command="{Binding FormatMacRows}" Style="{StaticResource Quiet}" /></WrapPanel><StackPanel><TextBlock Text="本次新增 / 更换列表" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="换绑时编辑“新 MAC”；上方输入也可不整理列表，直接点下一步。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,8" /></StackPanel></DockPanel>
            <DataGrid x:Name="MacDraftGrid" ItemsSource="{Binding MacRows}" IsReadOnly="False" MinHeight="90" MaxHeight="220" CellEditEnding="MacDraftCellEditEnding">
              <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="原 MAC（只读）" Binding="{Binding OldAddress, Mode=OneWay}" IsReadOnly="True" Width="165" />
                <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="新 MAC / 新增 MAC" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="VLAN" Binding="{Binding Vlan, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                <DataGridTemplateColumn Header="目标端口" Width="*" MinWidth="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.PortNames, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" Margin="4,1" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="移除" Style="{StaticResource Quiet}" Command="{Binding DataContext.RemoveMacRow, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,2" MinHeight="28" Margin="0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
        <Border Background="#EFF5FF" BorderBrush="#D6E3FA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12" Visibility="{Binding IsSecureMac, Converter={StaticResource BoolVisibility}}">
          <StackPanel>
            <TextBlock Text="3  端口安全设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
            <WrapPanel>
              <StackPanel Width="300" Margin="0,0,24,0"><TextBlock Text="MAC 数量上限（maximum）" FontWeight="SemiBold" /><CheckBox Content="自动按每个端口最终绑定数填写" IsChecked="{Binding MacAutomaticMaximum}" Margin="0,8,0,7" /><TextBox Text="{Binding MacMaximum, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding MacManualMaximum}" Width="90" HorizontalAlignment="Left" Margin="0" AutomationProperties.Name="MAC 数量上限" /></StackPanel>
              <StackPanel Width="330"><TextBlock Text="违规时怎么处理？" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding MacViolations}" SelectedItem="{Binding SelectedMacViolation}" DisplayMemberPath="Label" AutomationProperties.Name="端口违规动作" Margin="0,8,0,5" /><TextBlock Text="{Binding MacViolationHelp}" Style="{StaticResource MutedText}" FontSize="11" /></StackPanel>
            </WrapPanel>
            <TextBlock Text="{Binding MacCountSummary}" Foreground="#1D4ED8" Margin="0,10,0,0" />
            <TextBlock Text="手动上限高于静态绑定数时，空余名额可能动态学习其他 MAC；实际上限以设备型号为准。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <Expander Header="高级：不同端口批量映射 / 多项配置一起提交" Foreground="#64748B" Margin="0,0,0,12"><StackPanel Margin="0,10,0,0"><TextBlock Text="不同端口可每行粘贴 MAC,VLAN,完整端口。需要和其他修改一起执行时，可存为批量草稿；普通操作直接点下一步。" Style="{StaticResource MutedText}" FontSize="12" /><Button Content="存为批量草稿" Click="StageMacClick" HorizontalAlignment="Left" Margin="0,10,0,0" /></StackPanel></Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="White" BorderBrush="#DCE4EF" BorderThickness="0,1,0,0" Padding="16,12" Margin="0,8,0,0">
      <DockPanel><Button DockPanel.Dock="Right" Content="下一步：审核并执行 →" Command="{Binding ReviewMacOperation}" Style="{StaticResource Primary}" Margin="18,0,0,0" /><StackPanel><TextBlock Text="{Binding MacInputMessage}" FontSize="12" Foreground="#475569" /><TextBlock Text="确认后：关闭端口 → 更换绑定 → 启用端口 → 验证 → 保存配置。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" Visibility="{Binding IsSecureMac, Converter={StaticResource BoolVisibility}}" /></StackPanel></DockPanel>
    </Border>
  </Grid>
</UserControl>
