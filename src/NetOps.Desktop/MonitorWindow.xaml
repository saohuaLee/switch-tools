<Window x:Class="NetOps.Desktop.MonitorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设备监控设置" Style="{StaticResource {x:Type Window}}" Width="720" Height="750" MinHeight="650" MinWidth="650" WindowStartupLocation="CenterOwner">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="查看设备状态与异常提醒" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="DeviceLabel" Style="{StaticResource MutedText}" Margin="0,8,0,18"/><WrapPanel><CheckBox x:Name="EnabledBox" Content="启用后台监控"/><CheckBox x:Name="MaintenanceBox" Content="维护模式（暂停探测与新告警）"/></WrapPanel></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
      <TextBlock Text="怎样获取交换机的运行状态？" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="如果已经可以用登录账户连接设备，可选择“使用已有登录连接”。管理员另给了监控账户时，再选择专用监控方式。" Style="{StaticResource MutedText}" Margin="0,8,0,6"/><ComboBox x:Name="ProtocolBox" DisplayMemberPath="Label" SelectionChanged="ProtocolChanged"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="轮询间隔（秒）"/><TextBox x:Name="IntervalBox" Text="60"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="连续失败判不可达次数"/><TextBox x:Name="FailureBox" Text="3"/></StackPanel></Grid>
      <StackPanel x:Name="SnmpPanel"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SNMP 端口"/><TextBox x:Name="PortBox" Text="161"/></StackPanel><StackPanel Grid.Column="2" x:Name="AuthPanel"><TextBlock Text="认证方式"/><ComboBox x:Name="AuthBox"><ComboBoxItem Content="SHA-256"/><ComboBoxItem Content="SHA-1（旧设备兼容）"/></ComboBox></StackPanel></Grid>
      <StackPanel x:Name="V3Panel"><TextBlock Text="SNMPv3 用户名"/><TextBox x:Name="UsernameBox" MaxLength="128"/><TextBlock Text="认证口令（留空保留）"/><PasswordBox x:Name="AuthenticationBox"/><TextBlock Text="AES-128 加密口令（留空保留）"/><PasswordBox x:Name="PrivacyBox"/></StackPanel><StackPanel x:Name="V2Panel"><TextBlock Text="只读 community（留空保留）"/><PasswordBox x:Name="CommunityBox"/><TextBlock Text="SNMPv2c 使用明文 community，请按设备实际支持情况选择。" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></StackPanel>
      <TextBlock x:Name="SshHint" Text="使用设备现有 SSH 连接档案的用户名、凭据与可信指纹。监控使用独立只读会话，不复用手动终端；具体命令和输出取决于设备系统。" Style="{StaticResource MutedText}"/>
      <TextBlock Text="模拟设备只生成带标记的本地演示采样，不连接网络。真实设备的可达状态与指标采集质量分别判断。" Style="{StaticResource MutedText}" Margin="0,16,0,0" FontSize="12"/>
    <Expander Header="调整告警阈值（按需展开）" Margin="0,20,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="CPU 持续超限阈值（%）"/><TextBox x:Name="CpuBox" Text="85"/><TextBlock Text="内存持续超限阈值（%）"/><TextBox x:Name="MemoryBox" Text="90"/><TextBlock Text="温度持续超限阈值（℃，留空不启用）"/><TextBox x:Name="TemperatureBox"/><TextBlock Text="连续超限采样次数"/><TextBox x:Name="AlarmSamplesBox" Text="3"/><TextBlock Text="温度应依据设备和传感器规范设置；CPU/内存回落 5 个百分点、温度回落 3℃后恢复。缺失、过期或无效的数值不会当作 0，也不会触发资源超限告警。" Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Expander>
    <Expander Header="高级指标：自定义采集项（OID）" Margin="0,20,0,12"><StackPanel Margin="0,12,0,0"><TextBlock Text="默认读取标准 CPU、物理内存和温度传感器表。设备仅提供厂商私有指标时，可填写精确的标量 OID；自定义值需直接返回百分比或摄氏度。" Style="{StaticResource MutedText}" Margin="0,0,0,18"/><TextBlock Text="CPU 使用率 OID（可选）"/><TextBox x:Name="CpuOidBox"/><TextBlock Text="内存使用率 OID（可选）"/><TextBox x:Name="MemoryOidBox"/><TextBlock Text="温度 OID（可选，单位为 ℃）"/><TextBox x:Name="TemperatureOidBox"/><TextBlock Text="自定义 / SSH 指标所属堆叠成员编号（可选）"/><TextBox x:Name="MemberBox"/><TextBlock Text="未提供明确成员归属时，标记为归属未提供，不会复制主控数值给每个成员。高级 OID 当前不执行单位换算或推断。" Style="{StaticResource MutedText}"/></StackPanel></Expander></StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="ErrorText" Foreground="#BE123C" Margin="0,0,0,12"/><WrapPanel HorizontalAlignment="Right"><Button Content="取消" Click="CancelClick"/><Button Content="保存监控设置" Click="SaveClick" Style="{StaticResource Primary}" Margin="0"/></WrapPanel></StackPanel>
  </Grid>
</Window>
