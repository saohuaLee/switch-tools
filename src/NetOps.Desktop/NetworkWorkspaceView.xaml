<UserControl x:Class="NetOps.Desktop.NetworkWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="14" Margin="0"><DockPanel><Button DockPanel.Dock="Top" Content="＋ 创建网络" Command="{Binding CreateWorkNetwork}" Style="{StaticResource Primary}" Margin="0,0,0,12" /><DataGrid ItemsSource="{Binding Vlans}" SelectedItem="{Binding WorkVlan}" IsEnabled="{Binding WorkCanSelect}" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="网络编号" Binding="{Binding Id}" Width="90" ElementStyle="{StaticResource GridCellText}" /><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource GridCellText}" /></DataGrid.Columns></DataGrid></DockPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="{Binding NetworkHeading}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding NetworkUsage}" Style="{StaticResource MutedText}" Margin="0,8,0,12" /><TextBlock Text="{Binding WorkNotice}" Foreground="{Binding WorkNoticeColor}" Visibility="{Binding WorkHasNotice, Converter={StaticResource BoolVisibility}}" /><WrapPanel Visibility="{Binding NetworkHasSelection, Converter={StaticResource BoolVisibility}}"><Button Content="修改名称" Command="{Binding RenameWorkNetwork}" /><Button Content="删除这个网络" Command="{Binding DeleteWorkNetwork}" /></WrapPanel></StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding NetworkCanEdit}" Margin="0,14,10,0">
        <StackPanel Visibility="{Binding NetworkCreating, Converter={StaticResource BoolVisibility}}"><TextBlock Text="新网络编号（1–4094）" FontWeight="SemiBold" /><TextBox Text="{Binding NetworkNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="创建网络编号" /></StackPanel>
        <StackPanel Visibility="{Binding NetworkNaming, Converter={StaticResource BoolVisibility}}"><TextBlock Text="网络名称" FontWeight="SemiBold" /><TextBox Text="{Binding NetworkName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="网络名称" /><TextBlock Text="使用英文字母、数字、下划线或短横线；创建时留空会自动命名，例如 VLAN20。" Style="{StaticResource MutedText}" FontSize="12" /></StackPanel>
        <TextBlock Text="将删除这个网络。默认网络、管理网络和仍有端口使用的网络不能删除；点击检查后仍需确认。" Foreground="#9A650D" Visibility="{Binding NetworkDeleting, Converter={StaticResource BoolVisibility}}" />
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding NetworkError}" Foreground="#B42332" Margin="0,0,0,10" /><Button Content="检查并应用网络修改" Command="{Binding ReviewWorkNetwork}" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0" Visibility="{Binding NetworkEditing, Converter={StaticResource BoolVisibility}}" /></StackPanel>
    </Grid></Border>
  </Grid>
</UserControl>
