<Window x:Class="NetOps.Desktop.ImportDevicesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="批量添加交换机" Style="{StaticResource {x:Type Window}}" Width="850" Height="650" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="从表格批量添加交换机" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="先选文件 → 核对下方清单 → 确认添加。添加后不会自动登录或修改设备。" Style="{StaticResource MutedText}" Margin="0,9,0,16" /><WrapPanel><Button Content="1. 选择 CSV 或 Excel 文件" Click="ChooseFileClick" Style="{StaticResource Primary}" /><Button Content="没有表格？保存填写示例" Click="SaveExampleClick" /></WrapPanel><TextBlock x:Name="FileLabel" Text="还没有选择文件。可先保存示例，按示例填写设备名称、管理 IP 和厂商。" Style="{StaticResource MutedText}" Margin="0,12,0,14" /></StackPanel>
    <DataGrid Grid.Row="1" x:Name="PreviewGrid"><DataGrid.Columns><DataGridTextColumn Header="设备名称" Binding="{Binding Name}" ElementStyle="{StaticResource GridCellText}" Width="*" /><DataGridTextColumn Header="管理地址" Binding="{Binding ManagementIp}" ElementStyle="{StaticResource GridCellText}" Width="140" /><DataGridTextColumn Header="厂商" Binding="{Binding VendorLabel}" ElementStyle="{StaticResource GridCellText}" Width="100" /><DataGridTextColumn Header="位置 / 分组" Binding="{Binding Location}" ElementStyle="{StaticResource GridCellText}" Width="*" /><DataGridCheckBoxColumn Header="练习设备" Binding="{Binding IsSimulation}" Width="90" /></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Text="软件会整批检查；有错误时不会只添加一部分。真实设备添加后仍需填写连接账户与可信指纹。" Style="{StaticResource MutedText}" Margin="0,0,0,12" /><DockPanel><Button DockPanel.Dock="Left" Content="取消" IsCancel="True" /><Button x:Name="ImportButton" Content="2. 核对无误，添加这些设备" Click="ImportClick" IsEnabled="False" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0" /></DockPanel></StackPanel>
  </Grid>
</Window>
