<UserControl x:Class="NetOps.Desktop.HistoryWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="立即备份当前配置" VerticalAlignment="Center" Command="{Binding Backup}" Style="{StaticResource Primary}" Margin="12,0,0,0" /><StackPanel><TextBlock Text="备份与操作记录" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="备份只读取并保存到本机。下方可以查看副本及每次操作的结果。" Style="{StaticResource MutedText}" Margin="0,7,0,0" /><TextBlock Text="{Binding WorkNotice}" Foreground="{Binding WorkNoticeColor}" Visibility="{Binding WorkHasNotice, Converter={StaticResource BoolVisibility}}" Margin="0,7,0,0" /></StackPanel></DockPanel>
    <TabControl Grid.Row="1" Style="{StaticResource WorkspaceTabs}" SelectedIndex="0"><TabItem Header="配置备份"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding TimeLabel}" Width="165" ElementStyle="{StaticResource GridCellText}" /><DataGridTextColumn Header="来源" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource GridCellText}" /></DataGrid.Columns></DataGrid><Border Grid.Column="2" Style="{StaticResource Card}" Margin="0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="选择左侧一份备份查看配置原文。此页不提供一键自动恢复。" Style="{StaticResource MutedText}" Margin="0,0,0,10" /><Expander DockPanel.Dock="Bottom" Header="更多：比较备份与当前配置" Margin="0,12,0,0"><StackPanel><TextBlock Text="按文本行位置比较；需要先读取当前配置。结果显示在上方，不会恢复或修改设备。" Style="{StaticResource MutedText}" FontSize="12" /><Button Content="与当前读取配置比较" Command="{Binding CompareSnapshot}" HorizontalAlignment="Left" /></StackPanel></Expander><TextBox Text="{Binding SnapshotText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, Microsoft YaHei UI" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" /></DockPanel></Border></Grid></TabItem><TabItem Header="操作记录"><DataGrid ItemsSource="{Binding Audit}"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding TimeLabel}" Width="130" ElementStyle="{StaticResource GridCellText}" /><DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="150" ElementStyle="{StaticResource GridCellText}" /><DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="*" ElementStyle="{StaticResource GridCellText}" /></DataGrid.Columns></DataGrid></TabItem></TabControl>
  </Grid>
</UserControl>
