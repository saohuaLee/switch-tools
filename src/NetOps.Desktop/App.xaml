<Application x:Class="NetOps.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#152235"/><SolidColorBrush x:Key="Line" Color="#304159"/><SolidColorBrush x:Key="Muted" Color="#ADBDD2"/><SolidColorBrush x:Key="Accent" Color="#6BE0BC"/>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <Style TargetType="Window"><Setter Property="Background" Value="#0C1422"/><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="Background" Value="#263A52"/><Setter Property="BorderBrush" Value="#425B77"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#6BE0BC"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#6BE0BC"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#6BE0BC"/><Setter Property="Foreground" Value="#0A2922"/><Setter Property="BorderBrush" Value="#6BE0BC"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0C1728"/><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="BorderBrush" Value="#425B77"/><Setter Property="CaretBrush" Value="#ECF2FA"/><Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,5,0,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0C1728"/><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="BorderBrush" Value="#425B77"/><Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,5,0,10"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="Margin" Value="0,7,8,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="Background" Value="#152235"/><Setter Property="Padding" Value="8,7"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#2B4E64"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="Background" Value="#0C1728"/><Setter Property="BorderBrush" Value="#425B77"/><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,5,0,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="#425B77" BorderThickness="1" CornerRadius="3"><Grid><ContentPresenter/><TextBlock Text="▾" Foreground="#ADBDD2" HorizontalAlignment="Right" Margin="0,0,9,0"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
        <ContentPresenter x:Name="Display" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="9,5,28,5" IsHitTestVisible="False" VerticalAlignment="Center"/>
        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="1,1,26,1" BorderThickness="0" Padding="8,5" Background="#0C1728" Foreground="#ECF2FA" MinHeight="0"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#152235" BorderBrush="#425B77" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="Display" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,11"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,4"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#285064"/><Setter Property="Foreground" Value="#ECF2FA"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#152235"/><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="#152235"/><Setter Property="AlternatingRowBackground" Value="#1A2A40"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="36"/><Setter Property="ColumnHeaderHeight" Value="36"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#293B52"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#20334A"/><Setter Property="Foreground" Value="#ADBDD2"/><Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#285064"/><Setter Property="Foreground" Value="#ECF2FA"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#ECF2FA"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="12,10"/><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,4,8"><ContentPresenter x:Name="Header" ContentSource="Header" TextElement.Foreground="#ADBDD2"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#6BE0BC"/><Setter TargetName="Header" Property="TextElement.Foreground" Value="#6BE0BC"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Application.Resources>
</Application>
