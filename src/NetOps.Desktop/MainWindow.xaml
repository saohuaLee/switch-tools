<Window x:Class="NetOps.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NetOps.Desktop" Title="网络运维工作台 · NetOps Studio 0.5.0" Style="{StaticResource {x:Type Window}}" Width="1480" Height="920" MinWidth="1180" MinHeight="740" WindowStartupLocation="CenterScreen" Language="zh-CN">
  <Window.InputBindings>
    <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackToDevices}" />
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="88" />
      <RowDefinition />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Border Grid.RowSpan="3" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,22" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="8,0,0,28">
            <Border Background="#2563EB" CornerRadius="9" Width="36" Height="36">
              <TextBlock Text="N" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Margin="10,0,0,0">
              <TextBlock Text="网络运维工作台" FontSize="15" FontWeight="Bold" />
              <TextBlock Text="NETOPS STUDIO" FontSize="9" Foreground="#94A3B8" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>
          <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=2, Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16" />
              <TextBlock Text="设备中心" />
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=0, Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16" />
              <TextBlock Text="网络总览" />
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=1, Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16" />
              <TextBlock Text="网络拓扑" />
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=3, Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16" />
              <TextBlock Text="告警与事件" />
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=4, Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="4">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16" />
              <TextBlock Text="批量草稿（可选）" />
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=5, Mode=OneWay}" Command="{Binding Navigate}" CommandParameter="5">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16" />
              <TextBlock Text="系统设置" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Background="#F5F8FD" Padding="12" CornerRadius="8">
            <StackPanel>
              <TextBlock Text="{Binding CollectorLabel}" Foreground="#64748B" FontSize="11" />
              <TextBlock Text="版本 0.5.0 · 设备工作区" Foreground="#94A3B8" FontSize="10" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Column="1" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="24,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="刷新视图" Command="{Binding RefreshDashboard}" Visibility="{Binding IsDeviceWorkspace, Converter={StaticResource InverseVisibility}}" />
          <Button Content="AI 助手" Command="{Binding ToggleAi}" />
          <Button Content="{Binding QueueLabel}" Click="OpenQueueClick" Style="{StaticResource QueueButton}" Margin="0" />
        </StackPanel>
        <Button DockPanel.Dock="Left" x:Name="BackToDeviceListButton" Content="←  返回设备列表" Command="{Binding BackToDevices}" Style="{StaticResource BackButton}" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="{Binding IsDeviceWorkspace, Converter={StaticResource BoolVisibility}}" ToolTip="返回设备列表（Alt+←），保留筛选和编辑草稿" AutomationProperties.Name="返回设备列表" />
        <Grid VerticalAlignment="Center" Margin="0,0,16,0">
          <StackPanel Visibility="{Binding IsDeviceWorkspace, Converter={StaticResource InverseVisibility}}">
            <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Visibility="{Binding IsDeviceWorkspace, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding PageSubtitle}" Foreground="#64748B" FontSize="11" Margin="0,0,0,5" />
            <TextBlock Text="{Binding PageTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding PageTitle}" FontSize="21" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>
      </DockPanel>
    </Border>
    <TabControl Grid.Column="1" Grid.Row="1" SelectedIndex="{Binding Page}" Style="{StaticResource PageTabs}" Margin="22,18,22,16">
      <TabItem>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="235" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding OverviewHint}" Style="{StaticResource MutedText}" Margin="0,0,0,16" />
          <UniformGrid Grid.Row="1" Columns="4">
            <Border Style="{StaticResource Card}" Margin="0,0,12,18">
              <StackPanel>
                <TextBlock Text="纳管设备" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding TotalCount}" Foreground="#172B4D" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,6" />
                <TextBlock Text="含明确标识的模拟设备" Foreground="#94A3B8" FontSize="11" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,18">
              <StackPanel>
                <TextBlock Text="在线设备" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding OnlineCount}" Foreground="#138A67" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,6" />
                <TextBlock Text="依据当前有效采样" Foreground="#94A3B8" FontSize="11" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,18">
              <StackPanel>
                <TextBlock Text="不可达 / 待确认" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding OfflineCount}" Foreground="#D28B20" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,6" />
                <TextBlock Text="连续失败后确认异常" Foreground="#94A3B8" FontSize="11" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,18">
              <StackPanel>
                <TextBlock Text="当前告警" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding AlarmCount}" Foreground="#D94C61" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,6" />
                <TextBlock Text="持续超限与设备不可达" Foreground="#94A3B8" FontSize="11" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalCount, StringFormat=共 {0} 台设备}" Foreground="#64748B" FontSize="12" />
                <StackPanel>
                  <TextBlock Text="设备健康状态" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="选择设备查看下方趋势，点击「查看」进入设备工作区。" Foreground="#64748B" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
              </DockPanel>
              <DataGrid x:Name="HealthGrid" ItemsSource="{Binding DeviceRows}" SelectedItem="{Binding SelectedRow}" MouseDoubleClick="DeviceRowDoubleClick" RowHeight="48" CanUserResizeColumns="False">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="设备名称 / 管理地址" Width="2.8*" MinWidth="220" MaxWidth="380" CellTemplate="{StaticResource HealthDeviceIdentity}" />
                  <DataGridTemplateColumn Header="状态" Width="1.3*" MinWidth="110" HeaderStyle="{StaticResource HealthCenteredHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border Background="#F1F5F9" CornerRadius="5" Padding="10,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="12" />
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn ElementStyle="{StaticResource HealthMetricText}" HeaderStyle="{StaticResource HealthCenteredHeader}" Header="CPU" Binding="{Binding Cpu}" Width="*" MinWidth="76" />
                  <DataGridTextColumn ElementStyle="{StaticResource HealthMetricText}" HeaderStyle="{StaticResource HealthCenteredHeader}" Header="内存" Binding="{Binding Memory}" Width="*" MinWidth="76" />
                  <DataGridTextColumn ElementStyle="{StaticResource HealthMetricText}" HeaderStyle="{StaticResource HealthCenteredHeader}" Header="温度" Binding="{Binding Temperature}" Width="*" MinWidth="80" />
                  <DataGridTextColumn ElementStyle="{StaticResource HealthMetricText}" HeaderStyle="{StaticResource HealthCenteredHeader}" Header="最近采集" Binding="{Binding LastSeen}" Width="1.4*" MinWidth="108" />
                  <DataGridTemplateColumn Header="操作" Width="88" HeaderStyle="{StaticResource HealthCenteredHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="查看 →" Command="{Binding DataContext.OpenDevice, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource Quiet}" Padding="8,5" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
              </Grid.RowDefinitions>
              <DockPanel>
                <TextBlock Text="资源趋势" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedDevice.Name}" Foreground="#64748B" Margin="14,0,0,0" />
              </DockPanel>
              <Border Grid.Row="1" Margin="0,16,0,0">
                <UniformGrid Columns="3">
                  <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="CPU 使用率 · %" Style="{StaticResource MutedText}" FontSize="11" />
                    <local:TrendChart Samples="{Binding SelectedHistory}" Prefix="cpu" Height="145" />
                  </StackPanel>
                  <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="内存使用率 · %" Style="{StaticResource MutedText}" FontSize="11" />
                    <local:TrendChart Samples="{Binding SelectedHistory}" Prefix="memory" Height="145" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="温度 · ℃" Style="{StaticResource MutedText}" FontSize="11" />
                    <local:TrendChart Samples="{Binding SelectedHistory}" Prefix="temperature" Height="145" />
                  </StackPanel>
                </UniformGrid>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="自动布局" Click="AutoLayoutClick" />
              <Button Content="手工添加连接" Click="ManualLinkClick" />
              <Slider Width="110" Minimum="0.45" Maximum="1.2" Value="0.9" ValueChanged="TopologyZoomChanged" ToolTip="拓扑缩放" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel>
              <WrapPanel>
                <TextBlock Text="定位设备" Foreground="#64748B" />
                <TextBox Text="{Binding TopologySearch, UpdateSourceTrigger=PropertyChanged}" Width="175" Margin="10,0,10,6" ToolTip="搜索名称、地址、厂商或分组；保留关联邻居" />
                <ComboBox Width="150" ItemsSource="{Binding TopologyGroups}" SelectedItem="{Binding TopologyGroup}" Margin="0,0,0,6" />
              </WrapPanel>
              <TextBlock Text="实线：采集邻居 · 虚线：手工或过期 · 点线：成员关系" Foreground="#94A3B8" FontSize="10" />
            </StackPanel>
          </DockPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Border Background="#F8FAFD" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <local:TopologyCanvas x:Name="NetworkCanvas">
                  <local:TopologyCanvas.LayoutTransform>
                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                  </local:TopologyCanvas.LayoutTransform>
                </local:TopologyCanvas>
              </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="进入设备 / 端口" IsEnabled="{Binding CanOpenTopologyDevice}" Click="OpenTopologyDeviceClick" Style="{StaticResource Primary}" Margin="0,18,0,0" />
                <StackPanel>
                  <TextBlock Text="选中对象" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="{Binding TopologyNodeDetails}" LineHeight="24" Foreground="#64748B" />
                  <Button Content="展开 / 收起堆叠成员" Visibility="{Binding CanExpandStack, Converter={StaticResource BoolVisibility}}" Click="ToggleStackClick" Margin="0,20,0,0" />
                  <Button Content="移除此手工连接" Click="RemoveManualLinkClick" Style="{StaticResource Quiet}" Margin="0,10,0,0" Visibility="{Binding CanRemoveManualLink, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem>
        <Grid>
          <Grid Visibility="{Binding DeviceFocused, Converter={StaticResource InverseVisibility}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,14">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="发现设备" Click="DiscoverClick" />
                    <Button Content="导入清单" Click="ImportClick" />
                    <Button Content="＋ 添加设备" Click="AddDeviceClick" Style="{StaticResource Primary}" Margin="0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="从这里开始：先选一台设备" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DeviceCountLabel}" Foreground="#64748B" Margin="14,0,0,0" />
                  </StackPanel>
                </DockPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="选设备 → 选操作 → 填写 → 审核执行" Foreground="#64748B" FontSize="12" />
                  <TextBlock DockPanel.Dock="Left" Text="搜索" Foreground="#64748B" Margin="0,0,10,0" />
                  <TextBox DockPanel.Dock="Left" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="245" Margin="0,0,12,0" ToolTip="设备名称、管理地址、厂商、型号或分组" AutomationProperties.Name="搜索设备" />
                  <ComboBox DockPanel.Dock="Left" Width="150" ItemsSource="{Binding DeviceGroups}" SelectedItem="{Binding DeviceGroup}" Margin="0,0,8,0" AutomationProperties.Name="设备分组筛选" />
                  <Button Content="清除筛选" Command="{Binding ClearDeviceFilter}" Style="{StaticResource Quiet}" HorizontalAlignment="Left" />
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
              <Grid>
              <DataGrid ItemsSource="{Binding FilteredDeviceRows}" SelectedItem="{Binding SelectedRow}" MouseDoubleClick="DeviceRowDoubleClick" Visibility="{Binding HasFilteredDevices, Converter={StaticResource BoolVisibility}}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="设备名称" Width="*" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding SourceLabel}" Foreground="#94A3B8" FontSize="10" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="状态" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="管理地址" Binding="{Binding Address}" Width="125" />
                  <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="厂商 / 型号" Binding="{Binding VendorModel}" Width="190" />
                  <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="分组" Binding="{Binding Group}" Width="160" />
                  <DataGridTemplateColumn Header="操作" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="选择操作 →" Command="{Binding DataContext.OpenDevice, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#EFF5FF" BorderBrush="#D9E6FF" Foreground="#1D4ED8" Padding="10,5" Margin="0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasFilteredDevices, Converter={StaticResource InverseVisibility}}">
                <TextBlock Text="未找到匹配设备" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="尝试其他关键词或清除分组筛选。" Style="{StaticResource MutedText}" Margin="0,10,0,18" />
                <Button Content="清除筛选，查看全部设备" Command="{Binding ClearDeviceFilter}" HorizontalAlignment="Center" />
              </StackPanel>
              </Grid>
            </Border>
          </Grid>
          <Grid Visibility="{Binding DeviceFocused, Converter={StaticResource BoolVisibility}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                  <Button DockPanel.Dock="Right" Content="设备管理  ▾" Click="DeviceActionsClick" Margin="12,0,0,0" Padding="12,6" AutomationProperties.Name="设备管理菜单">
                    <Button.ContextMenu>
                      <ContextMenu Placement="Bottom">
                        <MenuItem Header="编辑设备与连接" Click="EditDeviceClick" />
                        <MenuItem Header="监控设置" Click="MonitorSettingsClick" />
                        <Separator />
                        <MenuItem Header="归档此设备…" Click="ArchiveClick" Foreground="#BE3349" />
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                  <Button DockPanel.Dock="Right" Content="{Binding DeviceQueueLabel}" Command="{Binding OpenDeviceQueue}" Margin="12,0,0,0" Padding="12,6">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="#EFF5FF" /><Setter Property="BorderBrush" Value="#C7D9FC" /><Setter Property="Foreground" Value="#1D4ED8" />
                        <Style.Triggers><DataTrigger Binding="{Binding DevicePendingCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Border DockPanel.Dock="Left" Background="#F1F5F9" CornerRadius="5" Padding="9,5" Margin="0,0,8,0"><TextBlock Text="{Binding CurrentHealth.SourceLabel}" FontSize="11" Foreground="#475569" /></Border>
                  <Border DockPanel.Dock="Left" Background="#F1F5F9" CornerRadius="5" Padding="9,5" Margin="0,0,12,0"><TextBlock Text="{Binding CurrentHealth.StatusLabel}" Foreground="{Binding CurrentHealth.StatusColor}" FontSize="11" FontWeight="SemiBold" /></Border>
                  <TextBlock Text="{Binding DeviceSummary}" Foreground="#64748B" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceSummary}" />
                </DockPanel>
                <DockPanel Visibility="{Binding ConnectionControlsVisible, Converter={StaticResource BoolVisibility}}">
                  <TextBlock DockPanel.Dock="Left" Text="连接配置" Foreground="#475569" Margin="0,0,12,0" />
                  <ComboBox DockPanel.Dock="Left" Width="210" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" DisplayMemberPath="Label" Margin="0,0,10,0" AutomationProperties.Name="设备连接配置" />
                  <Button DockPanel.Dock="Left" Content="{Binding ReadCurrentLabel}" Command="{Binding ReadCurrent}" Style="{StaticResource Primary}" Margin="0,0,16,0" />
                  <Button DockPanel.Dock="Right" Content="取消操作" Command="{Binding Cancel}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="8,0,0,0" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionStage}" Foreground="#475569" FontSize="12" />
                    <TextBlock Text="{Binding NextStepHint}" Foreground="#64748B" FontSize="11" Margin="0,4,0,0" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
              <DockPanel Visibility="{Binding TaskFormVisible, Converter={StaticResource BoolVisibility}}">
                <Button DockPanel.Dock="Left" Content="← 选择其他操作" Command="{Binding BackToTasks}" Margin="0,0,16,0" />
                <StackPanel><TextBlock Text="{Binding TaskTitle}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding TaskInstructions}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
              </DockPanel>
              <Border Background="#EAF7F0" BorderBrush="#BEE3CF" BorderThickness="1" Padding="14,10" CornerRadius="8" Margin="0,10,0,0" Visibility="{Binding HasLastResult, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding LastResult}" Foreground="#176746" /></Border>
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding TaskLanding, Converter={StaticResource BoolVisibility}}">
              <StackPanel>
                <TextBlock Text="你想在这台设备上做什么？" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,8" />
                <TextBlock Text="选择下面一项操作。填写完成后直接审核执行，无需先去其他页面提交。" Style="{StaticResource MutedText}" Margin="0,0,0,18" />
                <UniformGrid Columns="2">
                  <Button Command="{Binding ChooseTask}" CommandParameter="6" HorizontalContentAlignment="Stretch" Padding="20" Margin="0,0,14,14" Background="#EFF5FF" BorderBrush="#C9DAFA"><StackPanel><TextBlock Text="绑定 / 更换 MAC 地址" FontSize="18" FontWeight="SemiBold" Foreground="#1D4ED8" /><TextBlock Text="选择端口，输入一个或多个 MAC；自动识别格式和数量。" Foreground="#64748B" Margin="0,9,0,0" /></StackPanel></Button>
                  <Button Command="{Binding ChooseTask}" CommandParameter="1" HorizontalContentAlignment="Stretch" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="修改端口配置" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="修改 VLAN、端口描述、接入 / 干道模式或启停状态。" Foreground="#64748B" Margin="0,9,0,0" /></StackPanel></Button>
                  <Button Command="{Binding ChooseTask}" CommandParameter="2" HorizontalContentAlignment="Stretch" Padding="20" Margin="0,0,14,14"><StackPanel><TextBlock Text="创建 / 管理 VLAN" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="创建 VLAN、修改名称或删除不再使用的 VLAN。" Foreground="#64748B" Margin="0,9,0,0" /></StackPanel></Button>
                  <Button Command="{Binding ChooseTask}" CommandParameter="3" HorizontalContentAlignment="Stretch" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="备份与操作记录" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="备份当前配置，查看历史快照和操作结果。" Foreground="#64748B" Margin="0,9,0,0" /></StackPanel></Button>
                  <Button Command="{Binding ChooseTask}" CommandParameter="0" HorizontalContentAlignment="Stretch" Padding="20" Margin="0,0,14,0"><StackPanel><TextBlock Text="查看运行状态" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="查看 CPU、内存、温度及堆叠成员监控。" Foreground="#64748B" Margin="0,9,0,0" /></StackPanel></Button>
                  <Button Command="{Binding ChooseTask}" CommandParameter="4" HorizontalContentAlignment="Stretch" Padding="20" Margin="0"><StackPanel><TextBlock Text="手动命令终端" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="高级操作：通过 SSH、Console 或 Telnet 手动配置。" Foreground="#64748B" Margin="0,9,0,0" /></StackPanel></Button>
                </UniformGrid>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding NeedsTaskRead, Converter={StaticResource BoolVisibility}}">
              <StackPanel Margin="12"><TextBlock Text="开始前，先读取这台设备的当前配置" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="读取后会显示可操作的真实端口、VLAN 和已有 MAC，随后继续当前操作。读取过程不会修改设备配置。" Style="{StaticResource MutedText}" Margin="0,12,0,20" /><Button Content="读取配置，继续这项操作 →" Command="{Binding ReadCurrent}" Style="{StaticResource Primary}" HorizontalAlignment="Left" /><TextBlock Text="{Binding CapabilityHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" /></StackPanel>
            </Border>
            <TabControl Grid.Row="2" x:Name="WorkspaceTabs" SelectedIndex="{Binding Section}" Style="{StaticResource PageTabs}" Visibility="{Binding TaskContentVisible, Converter={StaticResource BoolVisibility}}">
              <TabItem Header="运行状态">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <DockPanel Margin="2,0,2,12">
                      <Button DockPanel.Dock="Right" Content="监控设置" Click="MonitorSettingsClick" Margin="12,0,0,0" />
                      <StackPanel>
                        <TextBlock Text="运行概况" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MetricsHint}" Foreground="#64748B" FontSize="11" Margin="0,5,0,0" />
                      </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Card}">
                      <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,20,0">
                          <TextBlock Text="CPU 使用率" Style="{StaticResource MutedText}" FontSize="12" />
                          <TextBlock Text="{Binding CurrentHealth.Cpu}" FontSize="27" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,8,0,8" />
                          <local:TrendChart Samples="{Binding SelectedHistory}" Prefix="cpu" Height="110" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,0">
                          <TextBlock Text="内存使用率" Style="{StaticResource MutedText}" FontSize="12" />
                          <TextBlock Text="{Binding CurrentHealth.Memory}" FontSize="27" FontWeight="SemiBold" Foreground="#8864D8" Margin="0,8,0,8" />
                          <local:TrendChart Samples="{Binding SelectedHistory}" Prefix="memory" Height="110" />
                        </StackPanel>
                        <StackPanel>
                          <TextBlock Text="设备温度" Style="{StaticResource MutedText}" FontSize="12" />
                          <TextBlock Text="{Binding CurrentHealth.Temperature}" FontSize="27" FontWeight="SemiBold" Foreground="#C98729" Margin="0,8,0,8" />
                          <local:TrendChart Samples="{Binding SelectedHistory}" Prefix="temperature" Height="110" />
                        </StackPanel>
                      </UniformGrid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <Expander Header="成员与传感器明细" Margin="0">
                        <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="堆叠成员监控" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="尚未取得堆叠成员信息，可先读取配置或检查监控设置。" Style="{StaticResource MutedText}" Margin="0,0,0,16" Visibility="{Binding HasMemberHealth, Converter={StaticResource InverseVisibility}}" />
                        <DataGrid ItemsSource="{Binding MemberHealthRows}" MaxHeight="180" Margin="0,0,0,18" Visibility="{Binding HasMemberHealth, Converter={StaticResource BoolVisibility}}">
                          <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="成员" Binding="{Binding Id}" Width="60" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="角色" Binding="{Binding Role}" Width="95" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="状态" Binding="{Binding Status}" Width="150" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="CPU" Binding="{Binding Cpu}" Width="90" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="内存" Binding="{Binding Memory}" Width="90" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="温度" Binding="{Binding Temperature}" Width="90" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="来源" Binding="{Binding Source}" Width="*" />
                          </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="传感器与成员指标" Style="{StaticResource SectionTitle}" />
                        <DataGrid ItemsSource="{Binding SelectedDeviceMetrics}" MinHeight="90" MaxHeight="220">
                          <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="指标 / 传感器" Binding="{Binding Label}" Width="*" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="成员" Binding="{Binding MemberId, TargetNullValue=归属未提供}" Width="110" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="数值" Binding="{Binding ValueLabel}" Width="100" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="来源" Binding="{Binding Source}" Width="*" />
                          </DataGrid.Columns>
                        </DataGrid>
                        </StackPanel>
                        </Expander>
                        <Expander Header="设备档案" Margin="0,12,0,0">
                          <UniformGrid Columns="3" Margin="0,14,0,0">
                            <StackPanel><TextBlock Text="设备型号 / 固件" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding SelectedDevice.Model}" FontWeight="SemiBold" Margin="0,8,0,6" /><TextBlock Text="{Binding SelectedDevice.Firmware}" Style="{StaticResource MutedText}" /></StackPanel>
                            <StackPanel><TextBlock Text="管理地址 / 分组" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding SelectedDevice.ManagementIp}" FontWeight="SemiBold" Margin="0,8,0,6" /><TextBlock Text="{Binding SelectedDevice.Location}" Style="{StaticResource MutedText}" /></StackPanel>
                            <StackPanel><TextBlock Text="配置读取状态" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ConnectionStage}" FontWeight="SemiBold" Margin="0,8,0,6" /><TextBlock Text="{Binding InventorySummary}" Style="{StaticResource MutedText}" /></StackPanel>
                          </UniformGrid>
                        </Expander>
                        <Expander Header="查看最近读取的配置原文">
                          <TextBox Text="{Binding ConnectionOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="200" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" />
                        </Expander>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="端口配置">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="编辑所选端口" Command="{Binding EditPorts}" Style="{StaticResource Primary}" />
                    <Button DockPanel.Dock="Right" Content="给所选端口绑定 MAC" Command="{Binding BindSelectedPorts}" />
                    <StackPanel><TextBlock Text="点击端口即可勾选，可同时选择多个端口" FontWeight="SemiBold" /><TextBlock Text="{Binding InventorySummary}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" /></StackPanel>
                  </DockPanel>
                  <TabControl Grid.Row="1">
                    <TabItem Header="端口面板">
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PortGroups}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource Card}">
                                <StackPanel>
                                  <DockPanel Margin="0,0,0,18">
                                    <Button DockPanel.Dock="Right" Content="选择本组端口" Command="{Binding DataContext.SelectPortGroup, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" />
                                  </DockPanel>
                                  <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <UniformGrid Columns="12" />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Button Background="{Binding Fill}" Padding="2,10" MinHeight="48" Margin="0,0,7,9" ToolTip="{Binding Detail}" Command="{Binding DataContext.TogglePort, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                          <StackPanel>
                                            <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectionMark}" HorizontalAlignment="Center" Foreground="#2563EB" FontSize="10" />
                                          </StackPanel>
                                        </Button>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </TabItem>
                    <TabItem Header="端口列表">
                      <DataGrid ItemsSource="{Binding Ports}" SelectionMode="Extended">
                        <DataGrid.Columns>
                          <DataGridTemplateColumn Header="选择" Width="54">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <CheckBox IsChecked="{Binding Picked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanConfigure, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0" HorizontalAlignment="Center" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="完整端口名称" Binding="{Binding State.Name}" Width="*" MinWidth="180" />
                          <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="模式" Binding="{Binding State.ModeLabel}" Width="75" />
                          <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="PVID" Binding="{Binding State.Pvid}" Width="65" />
                          <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="状态" Binding="{Binding State.StatusLabel}" Width="105" />
                          <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="端口描述" Binding="{Binding State.Description}" Width="*" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </TabItem>
                    <TabItem Header="堆叠成员">
                      <DataGrid ItemsSource="{Binding StackMembers}">
                        <DataGrid.Columns>
                          <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="成员" Binding="{Binding Id}" Width="90" />
                          <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="角色" Binding="{Binding Role}" Width="120" />
                          <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="状态" Binding="{Binding Status}" Width="120" />
                          <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="型号" Binding="{Binding Model}" Width="*" />
                          <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="物理端口数" Binding="{Binding PortCount, TargetNullValue=未确认}" Width="120" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </TabItem>
                  </TabControl>
                  <Border Grid.Row="2" Background="#EFF5FF" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="清空" Command="{Binding ClearSelection}" Margin="8,0,0,0" />
                      <Button DockPanel.Dock="Right" Content="全选接入口" Command="{Binding SelectAllPorts}" Margin="8,0,0,0" />
                      <Button DockPanel.Dock="Right" Content="选择范围" Command="{Binding SelectRange}" Margin="8,0,0,0" />
                      <TextBox DockPanel.Dock="Right" Text="{Binding PortRange, UpdateSourceTrigger=PropertyChanged}" Width="235" Margin="8,0,0,0" ToolTip="跨成员输入完整名称，如 GigabitEthernet1/0/1-8" />
                      <TextBlock Text="{Binding SelectionLabel}" FontWeight="SemiBold" />
                    </DockPanel>
                  </Border>
                </Grid>
              </TabItem>
              <TabItem Header="VLAN 管理" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="{Binding CapabilityHint}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                  <TabControl Grid.Row="1">
                    <TabItem Header="VLAN 列表">
                      <DataGrid ItemsSource="{Binding Vlans}" SelectedItem="{Binding SelectedVlan}">
                        <DataGrid.Columns>
                          <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="VLAN 编号" Binding="{Binding Id}" Width="130" />
                          <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="名称" Binding="{Binding Name}" Width="*" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </TabItem>
                    <TabItem Header="成员矩阵">
                      <DataGrid x:Name="MembershipGrid" ToolTip="PVID 为端口缺省 VLAN，允许为干道允许列表；本表不推断所有厂商的帧标签规则。" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                    </TabItem>
                  </TabControl>
                  <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                      <WrapPanel>
                        <ComboBox ItemsSource="{Binding VlanActions}" SelectedItem="{Binding VlanAction}" DisplayMemberPath="Label" Width="140" Margin="0,0,10,8" />
                        <Button Content="新建 VLAN" Command="{Binding NewVlan}" Margin="0,0,0,8" />
                      </WrapPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="编号" />
                          <TextBox Text="{Binding VlanId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="VLAN 编号" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="名称（字母、数字、下划线、短横线）" />
                          <TextBox Text="{Binding VlanName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="VLAN 名称" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding VlanValidation}" Foreground="#B45309" FontSize="12" Margin="0,0,0,8" />
                      <WrapPanel HorizontalAlignment="Right"><Button Content="存为批量草稿" Command="{Binding StageVlan}" Style="{StaticResource Quiet}" /><Button Content="下一步：审核并执行 →" Command="{Binding ReviewVlanOperation}" Style="{StaticResource Primary}" Margin="0" /></WrapPanel>
                    </StackPanel>
                  </Border>
                </Grid>
              </TabItem>
              <TabItem Header="配置备份" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="140" />
                    <RowDefinition />
                    <RowDefinition Height="130" />
                  </Grid.RowDefinitions>
                  <WrapPanel Margin="0,0,0,8">
                    <Button Content="备份当前配置" Command="{Binding Backup}" />
                    <Button Content="与当前模拟配置比较" Command="{Binding CompareSnapshot}" />
                  </WrapPanel>
                  <DataGrid Grid.Row="1" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" SelectionMode="Single">
                    <DataGrid.Columns>
                      <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="时间" Binding="{Binding TimeLabel}" Width="180" />
                      <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="来源" Binding="{Binding Reason}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBox Grid.Row="2" Text="{Binding SnapshotText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, Microsoft YaHei UI" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                  <DataGrid Grid.Row="3" ItemsSource="{Binding Audit}">
                    <DataGrid.Columns>
                      <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="时间" Binding="{Binding TimeLabel}" Width="120" />
                      <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="操作" Binding="{Binding Action}" Width="120" />
                      <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="结果" Binding="{Binding Result}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </TabItem>
              <TabItem Header="高级终端" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <WrapPanel>
                    <Button Content="连接终端" Command="{Binding ConnectTerminal}" Style="{StaticResource Primary}" />
                    <Button Content="断开" Command="{Binding DisconnectTerminal}" />
                    <CheckBox x:Name="AutoScrollTerminal" Content="自动滚动" IsChecked="True" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" Text="高级命令会直接发送到当前会话，可能修改设备。Console / Telnet 需按提示登录；分页可输入空格。记录保留在内存，不会自动发送给 AI。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,8" />
                  <TextBox Grid.Row="2" x:Name="TerminalTextBox" Text="{Binding TerminalOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" VerticalContentAlignment="Top" TextChanged="TerminalTextChanged" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                  <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <CheckBox x:Name="SecretInputToggle" Content="隐藏本次输入（密码等，不加入历史）" IsChecked="{Binding SecretInput}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                      <ComboBox IsEditable="True" ItemsSource="{Binding CommandHistory}" Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="终端命令">
                        <ComboBox.Style>
                          <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsChecked, ElementName=SecretInputToggle}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ComboBox.Style>
                      </ComboBox>
                      <PasswordBox x:Name="TerminalPassword" Visibility="{Binding IsChecked, ElementName=SecretInputToggle, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="隐藏终端输入" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="发送" Click="SendTerminalClick" VerticalAlignment="Bottom" Margin="8,0,0,10" IsEnabled="{Binding TerminalConnected}" />
                  </Grid>
                </Grid>
              </TabItem>
              <TabItem Visibility="Collapsed" />
              <TabItem Header="MAC 绑定"><local:MacBindingPanel /></TabItem>
              <TabItem Visibility="Collapsed" />
            </TabControl>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem>
        <Border Style="{StaticResource Card}" Margin="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="持续异常与恢复记录 · 确认处理后，恢复仍由新采样判断" Style="{StaticResource MutedText}" Margin="0,0,0,16" />
            <DataGrid ItemsSource="{Binding AlarmRows}">
              <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="发生时间" Binding="{Binding TimeLabel}" Width="130" />
                <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="目标设备" Binding="{Binding DeviceName}" Width="190" />
                <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="告警内容" Binding="{Binding Title}" Width="180" />
                <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="说明" Binding="{Binding Detail}" Width="*" />
                <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="状态" Binding="{Binding StateLabel}" Width="95" />
                <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="恢复时间" Binding="{Binding RecoveredAt, StringFormat=MM-dd HH:mm:ss, TargetNullValue=—}" Width="130" />
                <DataGridTemplateColumn Header="处理" Width="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="确认" Style="{StaticResource Quiet}" Command="{Binding DataContext.AcknowledgeAlarm, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,2" Margin="0" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </TabItem>
      <TabItem>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Content="审核当前设备变更" Command="{Binding ReviewQueue}" Style="{StaticResource Primary}" Margin="0,0,0,8" />
                <Button Content="返回设备工作区" Command="{Binding OpenDevice}" Margin="0" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{Binding QueueLabel}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="选择设备的一组修改后统一审核；执行前重新核对基线、身份与拓扑" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                <TextBlock Text="{Binding QueueValidation}" Foreground="#B45309" Margin="0,6,0,0" Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolVisibility}}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
            <Grid>
            <DataGrid ItemsSource="{Binding PendingChanges}" SelectedItem="{Binding SelectedPending}" Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolVisibility}}">
              <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="目标设备" Binding="{Binding DeviceName}" Width="250" />
                <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="修改内容" Binding="{Binding Summary}" Width="*" />
                <DataGridTemplateColumn Header="操作" Width="95">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="撤销此组" Style="{StaticResource Quiet}" Command="{Binding DataContext.RemovePending, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,2" Margin="0" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasPendingChanges, Converter={StaticResource InverseVisibility}}">
              <TextBlock Text="暂无待提交变更" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="在设备工作区编辑端口、VLAN 或 MAC，加入变更后在此统一审核。" Style="{StaticResource MutedText}" Margin="0,12,0,0" MaxWidth="420" TextAlignment="Center" />
            </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem>
        <TabControl>
          <TabItem Header="后台采集">
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="后台采集器" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding CollectorLabel}" FontSize="18" Foreground="#2563EB" Margin="0,0,0,16" />
                <TextBlock Text="采集器独立于桌面窗口运行，使用当前 Windows 用户的加密凭据。关闭窗口后继续采集；电脑休眠或断网期间的数据会标为过期。真实设备需在设备工作区设置协议和凭据后启用。" Style="{StaticResource MutedText}" MaxWidth="700" HorizontalAlignment="Left" />
                <WrapPanel Margin="0,20,0,0">
                  <Button Content="启动后台采集" Command="{Binding StartMonitoring}" Style="{StaticResource Primary}" />
                  <Button Content="停止后台采集" Command="{Binding StopMonitoring}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </TabItem>
          <TabItem Header="AI 服务">
            <ScrollViewer VerticalScrollBarVisibility="Auto" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
              <StackPanel Margin="2,0,12,0">
                <TextBlock Text="AI 服务配置" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="已保存配置" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding EditingProfile}" DisplayMemberPath="DisplayLabel" />
                <TextBlock Text="配置名称" />
                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="协议" />
                <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" DisplayMemberPath="Label" />
                <Button Content="填入所选协议的示例地址" Click="ProtocolPresetClick" HorizontalAlignment="Left" Margin="0,0,0,10" />
                <TextBlock Text="API 基础地址" />
                <TextBox Text="{Binding ProfileUrl, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="模型编号" />
                <TextBox Text="{Binding ProfileModel, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="密钥（留空保留已保存密钥）" />
                <PasswordBox x:Name="ApiKeyBox" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                <TextBlock x:Name="ProfileError" Foreground="#BE123C" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="保存配置" Click="SaveProfileClick" Style="{StaticResource Primary}" />
                  <Button Content="另存为新配置" Click="SaveNewProfileClick" />
                  <Button Content="设为默认" Click="SetDefaultProfileClick" />
                </WrapPanel>
                <TextBlock Text="支持 OpenAI、Claude、Gemini、DeepSeek 等兼容端点及本机 Ollama。当前为单次文本分析；模型能力、费用与账号权限需以供应商为准。" Style="{StaticResource MutedText}" Margin="0,16,0,0" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="驱动能力">
            <ScrollViewer VerticalScrollBarVisibility="Auto" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
              <StackPanel>
                <TextBlock Text="原方案功能与兼容等级" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="L1：通信、读取与 CLI；L2：图形化配置；L3：原生事务、回滚与监控。通信实现、模拟验证和真机验收分别记录。" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding DriverDescriptors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}">
                        <StackPanel>
                          <TextBlock Text="{Binding VendorLabel}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Family}" />
                          <TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" Margin="0,5,0,0" />
                          <TextBlock Text="{Binding Scope}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="原方案 P1：三层接口、静态路由、DHCP、防火墙/ACL/NAT 与自动化任务。本版已加入拓扑与监控。端口速率/双工、聚合及更完整的型号适配仍待实现，详见需求对照表。" Style="{StaticResource MutedText}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Background="White" Padding="26,5">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="取消当前操作" Command="{Binding Cancel}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" MinHeight="23" Padding="8,0" />
        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </DockPanel>
    </Border>
    <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#8021334D" Visibility="{Binding EditorOpen, Converter={StaticResource BoolVisibility}}">
      <Border Background="White" CornerRadius="14" Width="690" MaxHeight="660" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="关闭" Click="CloseEditorClick" Style="{StaticResource Quiet}" Margin="0" />
              <TextBlock Text="编辑端口配置" FontSize="21" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock Text="{Binding SelectionDetails}" Style="{StaticResource MutedText}" Margin="0,8,0,4" />
            <TextBlock Text="直接编辑即可记录修改；未编辑字段保持各端口原值" Foreground="#2563EB" FontSize="12" Margin="0,0,0,20" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid IsEnabled="{Binding CanConfigure}" Margin="0,0,8,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="24" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="保留原值" Command="{Binding ResetPortField}" CommandParameter="mode" Style="{StaticResource Quiet}" Padding="4,0" MinHeight="20" Margin="0" />
                  <TextBlock Text="端口模式" />
                </DockPanel>
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="保留原值" Command="{Binding ResetPortField}" CommandParameter="pvid" Style="{StaticResource Quiet}" Padding="4,0" MinHeight="20" Margin="0" />
                  <TextBlock Text="接入 VLAN / PVID" />
                </DockPanel>
                <ComboBox IsEditable="True" ItemsSource="{Binding AvailableVlans}" DisplayMemberPath="Id" Text="{Binding Pvid, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="同时创建此 VLAN" IsChecked="{Binding CreateInlineVlan}" />
                <TextBox Text="{Binding NewVlanName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CreateInlineVlan}" ToolTip="新 VLAN 名称" />
                <StackPanel Visibility="{Binding ShowAllowed, Converter={StaticResource BoolVisibility}}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="保留原值" Command="{Binding ResetPortField}" CommandParameter="allowed" Style="{StaticResource Quiet}" Padding="4,0" MinHeight="20" Margin="0" />
                    <TextBlock Text="干道允许 VLAN" />
                  </DockPanel>
                  <TextBox Text="{Binding AllowedVlans, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Text="支持 10,20,30-40；审核时显示替换差异" Style="{StaticResource MutedText}" FontSize="11" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="保留原值" Command="{Binding ResetPortField}" CommandParameter="description" Style="{StaticResource Quiet}" Padding="4,0" MinHeight="20" Margin="0" />
                  <TextBlock Text="端口描述" />
                </DockPanel>
                <TextBox Text="{Binding PortDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="目标端口描述" />
                <TextBlock Text="支持中文；编辑后留空会清除。多个端口原值不同时不自动覆盖。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,20" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="保留原值" Command="{Binding ResetPortField}" CommandParameter="enabled" Style="{StaticResource Quiet}" Padding="4,0" MinHeight="20" Margin="0" />
                  <TextBlock Text="管理状态" />
                </DockPanel>
                <CheckBox Content="启用端口" IsChecked="{Binding PortEnabled}" />
                <TextBlock Text="禁用操作会在审核中单独提示影响范围" Style="{StaticResource MutedText}" FontSize="11" />
                <Border Background="#F0F6FF" Padding="14" CornerRadius="8" Margin="0,22,0,0">
                  <StackPanel>
                    <TextBlock Text="本次修改" Foreground="#2563EB" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ModifiedFieldCount, StringFormat=已编辑 {0} 个字段}" Margin="0,6,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>
          <DockPanel Grid.Row="2" Margin="0,22,0,0">
            <Button DockPanel.Dock="Right" Content="下一步：审核并执行 →" Command="{Binding ReviewPortOperation}" Style="{StaticResource Primary}" Margin="16,0,0,0" />
            <Button DockPanel.Dock="Right" Content="存为批量草稿" Command="{Binding StagePorts}" Style="{StaticResource Quiet}" />
            <TextBlock Text="{Binding PortValidation}" Foreground="#B45309" FontSize="12" />
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#8021334D" Visibility="{Binding ReviewOpen, Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
      <Border Background="#FFFFFF" BorderBrush="#D8E0EB" BorderThickness="1" Width="960" HorizontalAlignment="Center" Margin="28" Padding="20" CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="审核本次变更" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PlanTitle}" Style="{StaticResource MutedText}" Margin="0,6,0,12" />
            <TextBlock Text="{Binding ReviewScope}" Foreground="#1D4ED8" FontSize="12" Margin="0,0,0,12" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="差异与影响范围" Style="{StaticResource SectionTitle}" />
              <ItemsControl ItemsSource="{Binding PlanDifferences}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="0,10">
                      <StackPanel>
                        <TextBlock Text="{Binding Target}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Before, StringFormat=变更前：{0}}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding After, StringFormat=变更后：{0}}" Foreground="#1D4ED8" Margin="0,5,0,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding PlanRisks}" Foreground="#B45309" Margin="0,16,0,12" />
              <Expander Header="厂商命令及中文解释" IsExpanded="True" Foreground="#64748B">
                <DataGrid ItemsSource="{Binding PlanCommandRows}" MaxHeight="300" RowHeight="NaN">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="英文命令" Binding="{Binding Command, Mode=OneWay}" Width="*">
                      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="8,7" /></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="中文解释" Binding="{Binding Explanation, Mode=OneWay}" Width="*">
                      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="8,7" /></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Expander>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <CheckBox x:Name="PlanConfirmBox" Content="我已核对目标设备、端口与变更差异" IsChecked="{Binding PlanConfirmed}" />
            <StackPanel Visibility="{Binding IsLivePlan, Converter={StaticResource BoolVisibility}}">
              <CheckBox IsChecked="{Binding LiveRiskAccepted}">
                <TextBlock Text="我了解这是实验性真实设备配置，已确认带外恢复途径；失败可能部分生效。" />
              </CheckBox>
              <CheckBox Content="回读验证通过后保存到启动配置" IsChecked="{Binding SaveAfterVerify}" IsEnabled="{Binding CanChooseSave}" />
            </StackPanel>
            <TextBlock Text="端口安全变更验证通过后自动执行 write memory（写入启动配置）；模拟设备只验证流程。" Style="{StaticResource MutedText}" FontSize="12" Visibility="{Binding IsSecurityPlan, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="{Binding Operation}" Foreground="{StaticResource Accent}" Margin="0,4,0,8" />
            <WrapPanel HorizontalAlignment="Right">
              <Button Content="返回继续编辑" Command="{Binding CloseReview}" />
              <Button Content="取消当前操作" Command="{Binding Cancel}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" />
              <Button Content="确认执行并验证" Command="{Binding ApplyPlan}" Style="{StaticResource Primary}" Margin="0" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#8021334D" Visibility="{Binding AiOpen, Converter={StaticResource BoolVisibility}}">
      <Border Width="650" Background="White" CornerRadius="14" Padding="26" Margin="30" HorizontalAlignment="Right">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="关闭" Command="{Binding ToggleAi}" Style="{StaticResource Quiet}" />
              <TextBlock Text="AI 辅助分析" FontSize="21" FontWeight="SemiBold" />
            </DockPanel>
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayLabel" />
            <TextBlock Text="{Binding SelectedProfile.BaseUrl}" Style="{StaticResource MutedText}" />
            <Expander Header="核对发送上下文">
              <TextBox Text="{Binding ContextPreview, Mode=OneWay}" IsReadOnly="True" Height="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            </Expander>
          </StackPanel>
          <TextBox Grid.Row="1" Text="{Binding AiAnswer, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
          <StackPanel Grid.Row="2">
            <TextBox Text="{Binding AiQuestion, UpdateSourceTrigger=PropertyChanged}" Height="85" TextWrapping="Wrap" AcceptsReturn="True" />
            <CheckBox IsChecked="{Binding ContextApproved}">
              <TextBlock Text="同意将问题与所示上下文发送到上述服务地址，问题中未包含凭据。" FontSize="12" />
            </CheckBox>
            <Button Content="发送分析" Command="{Binding AskAi}" Style="{StaticResource Primary}" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
