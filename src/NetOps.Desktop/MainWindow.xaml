<Window x:Class="NetOps.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="网络运维工作台 · NetOps Studio" Style="{StaticResource {x:Type Window}}" Width="1480" Height="940" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen" Language="zh-CN">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="88" /><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="340" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="网络运维工作台" FontSize="21" FontWeight="Bold" /><TextBlock Text="NetOps Studio  /  本地优先" Style="{StaticResource MutedText}" Margin="0,5,0,0" /></StackPanel>
        <StackPanel Grid.Column="1" Margin="20,0"><TextBlock Text="统一配置 · 可审核的每一次变更" FontSize="17" /><TextBlock Text="设备驱动 / 变更计划 / 智能排障" Style="{StaticResource MutedText}" Margin="0,5,0,0" /></StackPanel>
        <ComboBox Grid.Column="2" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" IsEnabled="{Binding Ready}" VerticalAlignment="Center" AutomationProperties.Name="当前设备" />
        <Button Grid.Column="3" Content="＋ 添加设备" Click="AddDeviceClick" IsEnabled="{Binding Ready}" Style="{StaticResource Primary}" Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#172C32" Padding="24,8"><TextBlock Foreground="#86E4C9" Text="开发预览版 0.1  ·  示例为模拟数据；真实设备仅支持实验性 SSH 只读，尚未通过真机兼容验证。" /></Border>
    <Grid Grid.Row="2" Margin="16,18,20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
      <TabControl TabStripPlacement="Left" IsEnabled="{Binding Ready}" Margin="0,0,18,0">
        <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Width" Value="154" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Margin" Value="0,0,14,6" /><Setter Property="Padding" Value="14,13" /></Style></TabControl.Resources>
        <TabItem Header="设备工作台">
          <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,0"><StackPanel>
            <TextBlock Text="设备工作台" FontSize="27" FontWeight="Bold" Margin="0,0,0,6" /><TextBlock Text="从一个工作区管理网络资产，所有连接由你发起。" Style="{StaticResource MutedText}" Margin="0,0,0,22" />
            <UniformGrid Columns="3" Margin="0,0,0,4">
              <Border Style="{StaticResource Card}" Margin="0,0,12,16"><StackPanel><TextBlock Text="设备档案" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding DeviceCount}" FontSize="32" Margin="0,8,0,0" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,16"><StackPanel><TextBlock Text="模拟设备" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding SimulationCount}" FontSize="32" Foreground="{StaticResource Accent}" Margin="0,8,0,0" /></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前连接端口（模拟）" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ConnectedPorts}" FontSize="32" Margin="0,8,0,0" /></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="设备清单" Style="{StaticResource SectionTitle}" /><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索设备" ToolTip="搜索设备名称、IP、厂商或位置" />
              <DataGrid ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice}" Height="198" SelectionMode="Single"><DataGrid.Columns>
                <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="*" MinWidth="175" /><DataGridTextColumn Header="管理地址" Binding="{Binding ManagementIp}" Width="116" /><DataGridTextColumn Header="厂商" Binding="{Binding VendorLabel}" Width="70" /><DataGridTextColumn Header="工作模式" Binding="{Binding ModeLabel}" Width="135" />
              </DataGrid.Columns></DataGrid>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="当前设备" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding DeviceSummary}" Margin="0,0,0,14" />
              <WrapPanel><Button Content="SSH 读取版本" Command="{Binding ReadVersion}" /><Button Content="备份当前配置" Command="{Binding Backup}" /></WrapPanel>
              <TextBlock Text="真实连接需先填写可信 SHA256 指纹与登录凭据。本阶段采用 SSH exec 通道，不支持所有设备的交互式 Shell。" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
              <TextBox Text="{Binding SshOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" />
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="端口配置">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,0"><StackPanel>
            <TextBlock Text="可视化端口配置" FontSize="27" FontWeight="Bold" /><TextBlock Text="{Binding DeviceSummary}" Style="{StaticResource MutedText}" Margin="0,8,0,20" />
            <Border Style="{StaticResource Card}"><StackPanel>
              <DockPanel Margin="0,0,0,16"><TextBlock Text="交换机端口面板" FontSize="18" /><TextBlock Text="{Binding SelectionLabel}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" /></DockPanel>
              <ItemsControl ItemsSource="{Binding Ports}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                <Button Content="{Binding Number}" Background="{Binding Fill}" ToolTip="{Binding Detail}" Padding="6,12" Margin="0,0,6,6" Command="{Binding DataContext.TogglePort, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="绿色：已连接  ·  深色：未连接  ·  紫色：上联  ·  亮色：已选" Style="{StaticResource MutedText}" Margin="0,10,0,12" /><Button Content="选择所有接入端口" Command="{Binding SelectAllPorts}" HorizontalAlignment="Left" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="配置所选端口" Style="{StaticResource SectionTitle}" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="端口模式" /><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label" AutomationProperties.Name="端口模式" /><TextBlock Text="允许的 VLAN（干道使用，逗号分隔）" /><TextBox Text="{Binding AllowedVlans, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="允许的 VLAN" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="PVID / 接入 VLAN" /><TextBox Text="{Binding Pvid, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="端口 PVID" /><TextBlock Text="端口描述（留空保留）" /><TextBox Text="{Binding PortDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="端口描述" /></StackPanel>
              </Grid>
              <CheckBox Content="启用所选端口" IsChecked="{Binding PortEnabled}" /><Button Content="生成端口变更预览" Command="{Binding PreviewPorts}" Style="{StaticResource Primary}" HorizontalAlignment="Left" />
            </StackPanel></Border>
            <DataGrid ItemsSource="{Binding Ports}" Height="280"><DataGrid.Columns><DataGridTextColumn Header="端口" Binding="{Binding State.Name}" Width="*" /><DataGridTextColumn Header="状态" Binding="{Binding State.StatusLabel}" Width="75" /><DataGridTextColumn Header="模式" Binding="{Binding State.ModeLabel}" Width="65" /><DataGridTextColumn Header="PVID" Binding="{Binding State.Pvid}" Width="60" /><DataGridTextColumn Header="角色" Binding="{Binding State.UplinkLabel}" Width="90" /></DataGrid.Columns></DataGrid>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="VLAN 管理">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,0"><StackPanel>
            <TextBlock Text="VLAN 管理" FontSize="27" FontWeight="Bold" /><TextBlock Text="{Binding DeviceSummary}" Style="{StaticResource MutedText}" Margin="0,8,0,20" />
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="现有 VLAN" Style="{StaticResource SectionTitle}" /><DataGrid ItemsSource="{Binding Vlans}" Height="240"><DataGrid.Columns><DataGridTextColumn Header="VLAN 编号" Binding="{Binding Id}" Width="150" /><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" /></DataGrid.Columns></DataGrid></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="创建 VLAN" Style="{StaticResource SectionTitle}" /><TextBlock Text="VLAN 编号（1–4094）" /><TextBox Text="{Binding VlanId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新建 VLAN 编号" /><TextBlock Text="VLAN 名称（英文字母、数字、下划线或短横线）" /><TextBox Text="{Binding VlanName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新建 VLAN 名称" /><Button Content="生成 VLAN 变更预览" Command="{Binding PreviewVlan}" Style="{StaticResource Primary}" HorizontalAlignment="Left" /></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="变更预览">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,0"><StackPanel>
            <TextBlock Text="先审核，再执行" FontSize="27" FontWeight="Bold" /><TextBlock Text="每个计划绑定设备基线，有效期 10 分钟，只能执行一次。" Style="{StaticResource MutedText}" Margin="0,8,0,20" />
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="变更差异" Style="{StaticResource SectionTitle}" /><DataGrid ItemsSource="{Binding PlanDifferences}" Height="190"><DataGrid.Columns><DataGridTextColumn Header="对象" Binding="{Binding Target}" Width="140" /><DataGridTextColumn Header="变更前" Binding="{Binding Before}" Width="*" /><DataGridTextColumn Header="变更后" Binding="{Binding After}" Width="*" /></DataGrid.Columns></DataGrid></StackPanel></Border>
            <Border Style="{StaticResource Card}" BorderBrush="#7B6641"><StackPanel><TextBlock Text="风险与执行范围" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding PlanRisks}" Foreground="#EAC487" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="厂商参考命令 · 实验性" Style="{StaticResource SectionTitle}" /><TextBlock Text="命令仅供预览，未处理真实设备的模式切换残留、固件差异、持久保存和回滚，不能据此认定可直接下发。" Style="{StaticResource MutedText}" /><TextBox Text="{Binding PlanCommands, Mode=OneWay}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" Height="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" /><CheckBox Content="我已核对以上差异与风险，确认执行本地模拟变更" IsChecked="{Binding PlanConfirmed}" /><Button Content="确认执行模拟计划" Command="{Binding ApplyPlan}" Style="{StaticResource Primary}" HorizontalAlignment="Left" IsEnabled="{Binding HasPlan}" /></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="配置与审计">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,0"><StackPanel>
            <TextBlock Text="配置中心" FontSize="27" FontWeight="Bold" /><TextBlock Text="备份按 Windows 当前用户加密保存；当前没有真实设备恢复入口。" Style="{StaticResource MutedText}" Margin="0,8,0,20" />
            <Border Style="{StaticResource Card}"><StackPanel><WrapPanel Margin="0,0,0,12"><Button Content="备份当前配置" Command="{Binding Backup}" Style="{StaticResource Primary}" /><Button Content="与当前模拟配置对比" Command="{Binding CompareSnapshot}" /></WrapPanel><DataGrid ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" Height="150" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="备份时间" Binding="{Binding TimeLabel}" Width="180" /><DataGridTextColumn Header="备份来源" Binding="{Binding Reason}" Width="*" /></DataGrid.Columns></DataGrid><TextBox Text="{Binding SnapshotText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Microsoft YaHei UI" Height="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前设备操作审计" Style="{StaticResource SectionTitle}" /><DataGrid ItemsSource="{Binding Audit}" Height="190"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding TimeLabel}" Width="125" /><DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="120" /><DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="*" /></DataGrid.Columns></DataGrid></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="AI 服务设置">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,0"><StackPanel>
            <TextBlock Text="接入你的 AI 服务" FontSize="27" FontWeight="Bold" /><TextBlock Text="支持独立协议与自定义基础地址；模型编号由你填写。" Style="{StaticResource MutedText}" Margin="0,8,0,20" />
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="已保存的配置" /><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="编辑 AI 配置" />
              <TextBlock Text="配置名称" /><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="AI 配置名称" />
              <TextBlock Text="API 协议" /><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" DisplayMemberPath="Label" AutomationProperties.Name="AI API 协议" />
              <TextBlock Text="API 基础地址（保留版本路径，不包含最终方法）" /><TextBox Text="{Binding ProfileUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="API 基础地址" />
              <TextBlock Text="模型编号（以服务商控制台为准）" /><TextBox Text="{Binding ProfileModel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="模型编号" />
              <TextBlock Text="API 密钥（已保存配置留空表示保留）" /><PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="API 密钥" />
              <WrapPanel><Button Content="保存当前配置" Click="SaveProfileClick" Style="{StaticResource Primary}" /><Button Content="另存为新配置" Click="SaveNewProfileClick" /></WrapPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="地址填写示例" Style="{StaticResource SectionTitle}" /><TextBlock Text="OpenAI 响应协议：https://api.openai.com/v1&#10;Claude 消息协议：https://api.anthropic.com/v1&#10;Gemini：https://generativelanguage.googleapis.com/v1beta&#10;DeepSeek 对话补全：https://api.deepseek.com&#10;Ollama：http://localhost:11434" Style="{StaticResource MutedText}" /><TextBlock Text="本阶段为单次文本分析，未提供流式输出、图片、函数调用或自动配置。首次使用请在右侧核对地址与上下文，再主动发送问题。" Margin="0,14,0,0" /></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="驱动与路线图">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,0"><StackPanel>
            <TextBlock Text="兼容性以验证为准" FontSize="27" FontWeight="Bold" /><TextBlock Text="登记厂商不等于支持所有型号；当前没有任何真机兼容认证。" Style="{StaticResource MutedText}" Margin="0,8,0,20" />
            <ItemsControl ItemsSource="{Binding DriverDescriptors}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16"><StackPanel><DockPanel><TextBlock Text="{Binding VendorLabel}" FontSize="17" Margin="0,0,12,0" /><TextBlock Text="{Binding Family}" Foreground="{StaticResource Muted}" /><TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" /></DockPanel><TextBlock Text="{Binding Scope}" Style="{StaticResource MutedText}" Margin="0,7,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="后续开发顺序" Style="{StaticResource SectionTitle}" /><TextBlock Text="下一阶段：实验室设备、SSH 交互会话、Console、厂商状态解析与真实配置闭环。&#10;随后：Telnet、NETCONF / RESTCONF、路由、DHCP、ACL 与防火墙策略。&#10;后续增强：批量任务、拓扑、监控、知识库与外部监控系统集成。" Style="{StaticResource MutedText}" /></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="18"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><DockPanel><TextBlock Text="智能排障助手" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="只读建议" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" /></DockPanel><TextBlock Text="基于当前设备的最小上下文分析" Style="{StaticResource MutedText}" Margin="0,8,0,14" /></StackPanel>
        <StackPanel Grid.Row="1" IsEnabled="{Binding Ready}"><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="排障模型配置" /><TextBlock Text="{Binding SelectedProfile.BaseUrl}" Style="{StaticResource MutedText}" FontSize="11" /><Expander Header="核对待发送的上下文" Foreground="#9CAFC7" Margin="0,10,0,10"><TextBox Text="{Binding ContextPreview, Mode=OneWay}" IsReadOnly="True" Height="160" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontSize="11" /></Expander></StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,5,0,12"><TextBox Text="{Binding AiAnswer, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" /></ScrollViewer>
        <StackPanel Grid.Row="3" IsEnabled="{Binding Ready}"><TextBox Text="{Binding AiQuestion, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="95" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="排障问题" /><CheckBox IsChecked="{Binding ContextApproved}"><TextBlock Text="我同意将问题和以上上下文发送至所选 API 地址，问题中未包含密码或密钥。" FontSize="11" /></CheckBox><Button Content="发送辅助分析" Command="{Binding AskAi}" Style="{StaticResource Primary}" Margin="0" /><TextBlock Text="AI 不能执行命令，分析结果需要人工核实。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0" /></StackPanel>
      </Grid></Border>
    </Grid>
    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,6"><DockPanel><Button Content="取消请求" Command="{Binding Cancel}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" DockPanel.Dock="Right" Padding="12,2" MinHeight="26" /><TextBlock Text="{Binding Status}" Foreground="#9CAFC7" FontSize="12" /></DockPanel></Border>
  </Grid>
</Window>
