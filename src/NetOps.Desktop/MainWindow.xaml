<Window x:Class="NetOps.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="网络运维工作台 · NetOps Studio" Style="{StaticResource {x:Type Window}}" Width="1380" Height="850" MinWidth="1060" MinHeight="680" WindowStartupLocation="CenterScreen" Language="zh-CN">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="32"/><RowDefinition/><RowDefinition Height="48"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,8"><DockPanel>
      <Button DockPanel.Dock="Right" Content="AI 排障助手" Command="{Binding ToggleAi}" Margin="10,0,0,0"/>
      <StackPanel Width="210"><TextBlock Text="网络运维工作台" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="NetOps Studio · 0.2" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel>
      <StackPanel><TextBlock Text="{Binding SelectedDevice.Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding DeviceSummary}" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel>
    </DockPanel></Border>
    <Border Grid.Row="1" Background="#1A3038" Padding="18,5"><TextBlock Text="{Binding WorkflowLabel}" Foreground="#9FE8D2" FontSize="12"/></Border>
    <Grid Grid.Row="2" Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="10"><DockPanel>
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="设备与分组" FontWeight="SemiBold" Margin="4,2,0,6"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索设备" ToolTip="搜索名称、地址、厂商或分组"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><WrapPanel Margin="0,8,0,6"><Button Content="添加" Click="AddDeviceClick" Padding="8,6"/><Button Content="编辑" Click="EditDeviceClick" Padding="8,6"/><Button Content="归档" Click="ArchiveClick" Padding="8,6" Margin="0"/></WrapPanel><Button Content="导入 CSV / Excel 清单" Click="ImportClick" Padding="8,6" Margin="0,0,0,6"/><Button Content="发现网络端点" Click="DiscoverClick" Padding="8,6" Margin="0"/></StackPanel>
        <ListBox ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice}" AutomationProperties.Name="设备列表"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ManagementIp}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/><TextBlock Text="{Binding Location}" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource Accent}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel></Border>
      <Grid Grid.Column="1" Margin="14,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,4"><ComboBox Width="206" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" DisplayMemberPath="Label" Margin="0,0,10,8" AutomationProperties.Name="当前连接配置"/><Button Content="读取当前配置" Command="{Binding ReadCurrent}" Margin="0,0,8,8" Style="{StaticResource Primary}"/><Button Content="备份" Command="{Binding Backup}" Margin="0,0,8,8"/><Button Content="连接设置" Click="EditDeviceClick" Margin="0,0,8,8"/><Button Content="高级终端" Click="OpenTerminalClick" Margin="0,0,0,8"/></WrapPanel>
        <TabControl Grid.Row="1" SelectedIndex="{Binding Section}" x:Name="WorkspaceTabs">
          <TabItem Header="概览"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="设备资料" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding SelectedDevice.RoleLabel}"/><TextBlock Text="{Binding SelectedDevice.Model}" Margin="0,5,0,0"/><TextBlock Text="{Binding SelectedDevice.Firmware}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="当前能力" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding CapabilityHint}" Style="{StaticResource MutedText}"/></StackPanel></Grid></Border>
            <TextBlock Grid.Row="1" Text="读取结果 · 连接与配置回显" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
            <TextBox Grid.Row="2" Text="{Binding ConnectionOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" VerticalContentAlignment="Top"/>
          </Grid></TabItem>
          <TabItem Header="端口"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding CapabilityHint}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
            <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="{Binding InventorySummary}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,8"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="180"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=StackDetails}" Value="True"><Setter Property="MaxHeight" Value="80"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><ItemsControl ItemsSource="{Binding PortGroups}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><DockPanel Margin="0,4,0,8"><Button DockPanel.Dock="Right" Content="选择此成员端口" Padding="8,3" Margin="8,0,0,0" Command="{Binding DataContext.SelectPortGroup, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Background="{Binding Fill}" Padding="4,7" Margin="0,0,5,5" ToolTip="{Binding Detail}" Command="{Binding DataContext.TogglePort, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding TileLabel}" FontSize="12"/><TextBlock Text="{Binding SelectionMark}" Margin="5,0,0,0" Foreground="#9FE8D2"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
              <Expander x:Name="StackDetails" Foreground="#ADBDD2" Header="堆叠成员与端口统计" Margin="0,4,0,0"><DataGrid ItemsSource="{Binding StackMembers}" MaxHeight="130"><DataGrid.Columns><DataGridTextColumn Header="成员" Binding="{Binding Id}" Width="55"/><DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="100"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="*"/><DataGridTextColumn Header="已采集物理端口" Binding="{Binding PortCount, TargetNullValue=未确认}" Width="120"/></DataGrid.Columns></DataGrid></Expander>
              <WrapPanel Margin="0,8,0,0"><TextBox Text="{Binding PortRange, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,6,0" AutomationProperties.Name="批量端口范围" ToolTip="单槽位可用 1-8；多槽位使用完整名称，如 GigabitEthernet1/0/1-8"/><Button Content="选择范围" Command="{Binding SelectRange}"/><Button Content="全选接入口" Command="{Binding SelectAllPorts}"/><Button Content="清空选择" Command="{Binding ClearSelection}"/></WrapPanel>
            </StackPanel></Border>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Ports}" SelectionMode="Extended"><DataGrid.Columns>
              <DataGridTemplateColumn Header="选择" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Picked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanConfigure, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="选择端口" HorizontalAlignment="Center" Margin="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="端口" Binding="{Binding State.Name}" Width="*" MinWidth="160"/><DataGridTextColumn Header="模式" Binding="{Binding State.ModeLabel}" Width="65"/><DataGridTextColumn Header="PVID" Binding="{Binding State.Pvid}" Width="58"/><DataGridTextColumn Header="状态" Binding="{Binding State.StatusLabel}" Width="100"/><DataGridTextColumn Header="描述" Binding="{Binding State.Description}" Width="*" MinWidth="110"/>
            </DataGrid.Columns></DataGrid>
            <Border Grid.Row="3" Background="#1C3045" Padding="10" Margin="0,8,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="编辑所选端口" Command="{Binding EditPorts}" Style="{StaticResource Primary}" Margin="8,0,0,0"/><StackPanel><TextBlock Text="{Binding SelectionLabel}" FontWeight="SemiBold"/><TextBlock Text="单端口读取原值；多端口只提交勾选字段" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></DockPanel></Border>
          </Grid></TabItem>
          <TabItem Header="VLAN"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding CapabilityHint}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
            <TabControl Grid.Row="1"><TabItem Header="VLAN 列表"><DataGrid ItemsSource="{Binding Vlans}" SelectedItem="{Binding SelectedVlan}"><DataGrid.Columns><DataGridTextColumn Header="VLAN 编号" Binding="{Binding Id}" Width="130"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="成员矩阵"><DataGrid x:Name="MembershipGrid" ToolTip="PVID 为端口缺省 VLAN，允许为干道允许列表；本表不推断所有厂商的帧标签规则。"/></TabItem></TabControl>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><WrapPanel><ComboBox ItemsSource="{Binding VlanActions}" SelectedItem="{Binding VlanAction}" DisplayMemberPath="Label" Width="140" Margin="0,0,10,8"/><Button Content="新建 VLAN" Command="{Binding NewVlan}" Margin="0,0,0,8"/></WrapPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="编号"/><TextBox Text="{Binding VlanId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="VLAN 编号"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="名称（字母、数字、下划线、短横线）"/><TextBox Text="{Binding VlanName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="VLAN 名称"/></StackPanel></Grid><TextBlock Text="{Binding VlanValidation}" Foreground="#F0BE94" FontSize="12" Margin="0,0,0,8"/><Button Content="预览 VLAN 变更" Command="{Binding PreviewVlan}" HorizontalAlignment="Right" Style="{StaticResource Primary}" Margin="0"/></StackPanel></Border>
          </Grid></TabItem>
          <TabItem Header="配置"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition/><RowDefinition Height="130"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><Button Content="备份当前配置" Command="{Binding Backup}"/><Button Content="与当前模拟配置比较" Command="{Binding CompareSnapshot}"/></WrapPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding TimeLabel}" Width="180"/><DataGridTextColumn Header="来源" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
            <TextBox Grid.Row="2" Text="{Binding SnapshotText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, Microsoft YaHei UI" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            <DataGrid Grid.Row="3" ItemsSource="{Binding Audit}"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding TimeLabel}" Width="120"/><DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="120"/><DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="*"/></DataGrid.Columns></DataGrid>
          </Grid></TabItem>
          <TabItem Header="高级终端"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel><Button Content="连接终端" Command="{Binding ConnectTerminal}" Style="{StaticResource Primary}"/><Button Content="断开" Command="{Binding DisconnectTerminal}"/><CheckBox x:Name="AutoScrollTerminal" Content="自动滚动" IsChecked="True"/></WrapPanel>
            <TextBlock Grid.Row="1" Text="高级命令会直接发送到当前会话，可能修改设备。Console / Telnet 需按提示登录；分页可输入空格。记录保留在内存，不会自动发送给 AI。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,8"/>
            <TextBox Grid.Row="2" x:Name="TerminalTextBox" Text="{Binding TerminalOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" VerticalContentAlignment="Top" TextChanged="TerminalTextChanged"/>
            <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><CheckBox x:Name="SecretInputToggle" Content="隐藏本次输入（密码等，不加入历史）" IsChecked="{Binding SecretInput}"/>
              <ComboBox IsEditable="True" ItemsSource="{Binding CommandHistory}" Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="终端命令"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=SecretInputToggle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
              <PasswordBox x:Name="TerminalPassword" Visibility="{Binding IsChecked, ElementName=SecretInputToggle, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="隐藏终端输入"/>
            </StackPanel><Button Grid.Column="1" Content="发送" Click="SendTerminalClick" VerticalAlignment="Bottom" Margin="8,0,0,10" IsEnabled="{Binding TerminalConnected}"/></Grid>
          </Grid></TabItem>
          <TabItem Header="AI 设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,0,12,0"><TextBlock Text="AI 服务配置" Style="{StaticResource SectionTitle}"/><TextBlock Text="已保存配置"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding EditingProfile}" DisplayMemberPath="DisplayLabel"/><TextBlock Text="配置名称"/><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="协议"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" DisplayMemberPath="Label"/><Button Content="填入所选协议的示例地址" Click="ProtocolPresetClick" HorizontalAlignment="Left" Margin="0,0,0,10"/><TextBlock Text="API 基础地址"/><TextBox Text="{Binding ProfileUrl, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="模型编号"/><TextBox Text="{Binding ProfileModel, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="密钥（留空保留已保存密钥）"/><PasswordBox x:Name="ApiKeyBox"/><TextBlock x:Name="ProfileError" Foreground="#F2B38E"/><WrapPanel Margin="0,8,0,0"><Button Content="保存配置" Click="SaveProfileClick" Style="{StaticResource Primary}"/><Button Content="另存为新配置" Click="SaveNewProfileClick"/><Button Content="设为默认" Click="SetDefaultProfileClick"/></WrapPanel><TextBlock Text="支持 OpenAI、Claude、Gemini、DeepSeek 等兼容端点及本机 Ollama。当前为单次文本分析；模型能力、费用与账号权限需以供应商为准。" Style="{StaticResource MutedText}" Margin="0,16,0,0"/></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="MAC 绑定"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="端口 MAC 绑定" Style="{StaticResource SectionTitle}"/><TextBlock Text="静态转发绑定指定目的 MAC 的出口；源 MAC 白名单限制接入口允许的终端，目前适配 Cisco IOS / IOS XE。所有变更先审核，再备份、执行并回读。" Style="{StaticResource MutedText}" Margin="0,0,0,8"/></StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding MacBindings}"><DataGrid.Columns>
              <DataGridTemplateColumn Header="选择" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Picked, UpdateSourceTrigger=PropertyChanged}" Margin="0" HorizontalAlignment="Center" AutomationProperties.Name="选择 MAC 绑定"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="MAC 地址" Binding="{Binding Binding.Address}" Width="160"/><DataGridTextColumn Header="VLAN" Binding="{Binding Binding.VlanId}" Width="60"/><DataGridTextColumn Header="端口" Binding="{Binding Binding.PortName}" Width="*"/><DataGridTextColumn Header="用途" Binding="{Binding Binding.KindLabel}" Width="120"/>
            </DataGrid.Columns></DataGrid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="95"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <WrapPanel><ComboBox Width="260" ItemsSource="{Binding MacKinds}" SelectedItem="{Binding SelectedMacKind}" DisplayMemberPath="Label" Margin="0,0,8,8"/><Button Content="填入所选端口模板" Command="{Binding MacTemplate}" Margin="0,0,0,8"/></WrapPanel>
              <TextBox Grid.Row="1" Text="{Binding MacBatch, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" AutomationProperties.Name="批量 MAC 绑定映射"/>
              <StackPanel Grid.Row="2"><TextBlock Text="每行：MAC,VLAN,完整端口，例如 00:11:22:33:44:55,10,GigabitEthernet1/0/1。每条 MAC 单独映射；迁移先删除旧绑定。" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock Text="{Binding MacValidation}" Foreground="#F0BE94" FontSize="12" Margin="0,5,0,8"/></StackPanel>
              <WrapPanel Grid.Row="3" HorizontalAlignment="Right"><Button Content="预览删除勾选绑定" Command="{Binding DeleteMac}"/><Button Content="预览批量添加" Command="{Binding PreviewMac}" Style="{StaticResource Primary}" Margin="0"/></WrapPanel>
            </Grid></Border>
          </Grid></TabItem>
          <TabItem Header="能力"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="原方案功能与兼容等级" Style="{StaticResource SectionTitle}"/><TextBlock Text="L1：通信、读取与 CLI；L2：图形化配置；L3：原生事务、回滚与监控。通信实现、模拟验证和真机验收分别记录。" Style="{StaticResource MutedText}" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding DriverDescriptors}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding VendorLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding Family}"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" Margin="0,5,0,0"/><TextBlock Text="{Binding Scope}" Style="{StaticResource MutedText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="原方案 P1：三层接口、静态路由、DHCP、防火墙/ACL/NAT 与自动化任务。P2：拓扑与监控。端口速率/双工、聚合及更完整的型号适配仍待实现，详见需求对照表。" Style="{StaticResource MutedText}"/></StackPanel></ScrollViewer></TabItem>
        </TabControl>
      </Grid>
      <Border Grid.Column="2" Width="310" Background="{StaticResource Panel}" Padding="14" Margin="12,0,0,0" CornerRadius="6" Visibility="{Binding EditorOpen, Converter={StaticResource BoolVisibility}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="收起" Click="CloseEditorClick" Padding="8,4" MinHeight="28" Margin="8,0,0,0"/><TextBlock Text="批量编辑端口" FontSize="18" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding SelectionDetails}" Style="{StaticResource MutedText}" Margin="0,8,0,12"/><TextBlock Text="只修改勾选字段，其余保持不变" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,0,0,10"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0" IsEnabled="{Binding CanConfigure}">
          <CheckBox Content="修改端口模式" IsChecked="{Binding ApplyMode}"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label" IsEnabled="{Binding ApplyMode}" AutomationProperties.Name="端口目标模式"/>
          <CheckBox Content="修改 PVID / 接入 VLAN" IsChecked="{Binding ApplyPvid}"/><ComboBox IsEditable="True" ItemsSource="{Binding Vlans}" DisplayMemberPath="Id" Text="{Binding Pvid, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ApplyPvid}" AutomationProperties.Name="目标 PVID"/>
          <StackPanel IsEnabled="{Binding ApplyPvid}"><CheckBox Content="同时创建上述 VLAN" IsChecked="{Binding CreateInlineVlan}"/><TextBox Text="{Binding NewVlanName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CreateInlineVlan}" AutomationProperties.Name="同步新建 VLAN 名称" ToolTip="新建 VLAN 名称使用字母、数字、下划线或短横线"/></StackPanel>
          <StackPanel Visibility="{Binding ShowAllowed, Converter={StaticResource BoolVisibility}}"><CheckBox Content="替换干道允许 VLAN 列表" IsChecked="{Binding ApplyAllowed}"/><TextBox Text="{Binding AllowedVlans, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ApplyAllowed}" AutomationProperties.Name="目标允许 VLAN 列表"/><TextBlock Text="支持 10,20,30-40；未勾选则保留原列表" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel>
          <CheckBox Content="修改端口启停状态" IsChecked="{Binding ApplyEnabled}"/><CheckBox Content="启用端口（取消表示禁用）" IsChecked="{Binding PortEnabled}" IsEnabled="{Binding ApplyEnabled}"/>
          <CheckBox Content="修改端口描述" IsChecked="{Binding ApplyDescription}"/><TextBox Text="{Binding PortDescription, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="目标端口描述" ToolTip="可直接输入中文或常用标点，编辑后自动勾选修改；取消勾选可保留原描述。"/><TextBlock Text="直接编辑会自动勾选；勾选后留空可清除。支持中文，最多 128 个 UTF-8 字节。" Style="{StaticResource MutedText}" FontSize="12"/>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding PortValidation}" Foreground="#F0BE94" FontSize="12" Margin="0,0,0,8"/><Button Content="预览所选端口变更" Command="{Binding PreviewPorts}" Style="{StaticResource Primary}" Margin="0"/></StackPanel>
      </Grid></Border>
      <Border Grid.Column="2" Width="310" Background="{StaticResource Panel}" Padding="14" Margin="12,0,0,0" CornerRadius="6" Visibility="{Binding AiOpen, Converter={StaticResource BoolVisibility}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="AI 辅助排障" Style="{StaticResource SectionTitle}"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayLabel" AutomationProperties.Name="排障模型"/><TextBlock Text="{Binding SelectedProfile.BaseUrl}" Style="{StaticResource MutedText}" FontSize="12"/><Expander Header="查看待发送上下文" Foreground="#ADBDD2" Margin="0,8,0,8"><TextBox Text="{Binding ContextPreview, Mode=OneWay}" IsReadOnly="True" Height="140" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/></Expander></StackPanel><TextBox Grid.Row="1" Text="{Binding AiAnswer, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/><StackPanel Grid.Row="2"><TextBox Text="{Binding AiQuestion, UpdateSourceTrigger=PropertyChanged}" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="排障问题"/><CheckBox IsChecked="{Binding ContextApproved}"><TextBlock Text="同意将问题和预览上下文发送至上述 API 地址，问题中未含密码或密钥。" FontSize="12"/></CheckBox><Button Content="发送分析" Command="{Binding AskAi}" Style="{StaticResource Primary}" Margin="0"/></StackPanel></Grid></Border>
    </Grid>
    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6"><DockPanel><Button DockPanel.Dock="Right" Content="取消操作" Command="{Binding Cancel}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="12,0,0,0" Padding="10,3" MinHeight="28"/><StackPanel><TextBlock Text="{Binding Operation}" Foreground="{StaticResource Accent}" FontSize="12"/><TextBlock Text="{Binding Status}" FontSize="12"/></StackPanel></DockPanel></Border>
    <Grid Grid.RowSpan="4" Background="#BA07101C" Visibility="{Binding ReviewOpen, Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
      <Border Background="#152235" BorderBrush="#425B77" BorderThickness="1" Width="730" HorizontalAlignment="Right" Margin="20" Padding="20" CornerRadius="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="审核本次变更" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding PlanTitle}" Style="{StaticResource MutedText}" Margin="0,6,0,12"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><TextBlock Text="差异与影响范围" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding PlanDifferences}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#304159" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel><TextBlock Text="{Binding Target}" FontWeight="SemiBold"/><TextBlock Text="{Binding Before, StringFormat=变更前：{0}}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><TextBlock Text="{Binding After, StringFormat=变更后：{0}}" Foreground="#9FE8D2" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding PlanRisks}" Foreground="#F0BE94" Margin="0,16,0,12"/><Expander Header="查看厂商命令" Foreground="#ADBDD2"><TextBox Text="{Binding PlanCommands, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="240" VerticalContentAlignment="Top"/></Expander></StackPanel></ScrollViewer><StackPanel Grid.Row="2" Margin="0,12,0,0"><CheckBox x:Name="PlanConfirmBox" Content="我已核对目标设备、端口与变更差异" IsChecked="{Binding PlanConfirmed}"/><StackPanel Visibility="{Binding IsLivePlan, Converter={StaticResource BoolVisibility}}"><CheckBox IsChecked="{Binding LiveRiskAccepted}"><TextBlock Text="我了解这是实验性真实设备配置，已确认带外恢复途径；失败可能部分生效。"/></CheckBox><CheckBox Content="回读验证通过后保存到启动配置" IsChecked="{Binding SaveAfterVerify}"/></StackPanel><TextBlock Text="{Binding Operation}" Foreground="{StaticResource Accent}" Margin="0,4,0,8"/><WrapPanel HorizontalAlignment="Right"><Button Content="返回继续编辑" Command="{Binding CloseReview}"/><Button Content="取消当前操作" Command="{Binding Cancel}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/><Button Content="确认执行并验证" Command="{Binding ApplyPlan}" Style="{StaticResource Primary}" Margin="0"/></WrapPanel></StackPanel></Grid></Border>
    </Grid>
  </Grid>
</Window>
