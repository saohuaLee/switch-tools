<UserControl x:Class="NetOps.Desktop.EasyWorkflowView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
      <DockPanel><Button DockPanel.Dock="Right" Content="操作帮助" Command="{Binding ToggleHelp}" Style="{StaticResource Quiet}" /><Button DockPanel.Dock="Right" Content="退出本次操作" Command="{Binding ExitEasy}" Style="{StaticResource Quiet}" /><StackPanel><TextBlock Text="{Binding EasyActionTitle}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{Binding EasyDeviceCaption}" Foreground="#64748B" FontSize="12" Margin="0,7,0,0" /><TextBlock Text="{Binding EasyProgress}" Foreground="#2563EB" Margin="0,7,0,0" /></StackPanel></DockPanel>
    </Border>
    <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="{Binding EasyStepTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,14" />
        <Border Background="#FFF1F0" BorderBrush="#F3C7C3" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14" Visibility="{Binding EasyHasError, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding EasyError}" Foreground="#A52F35" /></Border>
        <Border Style="{StaticResource Card}" Visibility="{Binding EasyConnectVisible, Converter={StaticResource BoolVisibility}}">
          <StackPanel><TextBlock Text="软件需要先知道设备上有哪些端口和网络。点击页面右下角的“连接并读取”。" FontSize="16" /><TextBlock Text="读取信息不会修改交换机配置。连接方式、账户或密码不正确时，可先打开下面的设置检查。" Style="{StaticResource MutedText}" Margin="0,12,0,16" /><Button Content="设备与连接设置" Click="ConnectionSettingsClick" HorizontalAlignment="Left" /><TextBlock Text="{Binding CapabilityHint}" Style="{StaticResource MutedText}" Margin="0,12,0,0" /></StackPanel>
        </Border>
        <StackPanel Visibility="{Binding EasySelectVisible, Converter={StaticResource BoolVisibility}}">
          <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel><TextBlock Text="端口就是交换机上插网线的插口。找到目标端口，勾选左侧方框。" FontSize="15" /><DockPanel Margin="0,12,0,8"><CheckBox DockPanel.Dock="Right" Content="同时设置多个端口" IsChecked="{Binding EasyMultiple}" Visibility="{Binding EasyCanSelectMultiple, Converter={StaticResource BoolVisibility}}" Margin="14,0,0,0" /><TextBlock DockPanel.Dock="Left" Text="搜索端口" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBox Text="{Binding EasySearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入端口编号、名称或网络编号" AutomationProperties.Name="搜索要操作的端口" Margin="0" /></DockPanel><TextBlock Text="{Binding EasySelectionSummary}" Foreground="#2563EB" Margin="0,4,0,10" />
              <DataGrid ItemsSource="{Binding EasyPorts}" MaxHeight="340" MinHeight="170" RowHeight="58" SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="选择" Width="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Picked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="端口" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" /><TextBlock Text="{Binding State.Name}" FontSize="11" Foreground="#8792A5" Margin="0,3,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="当前名称 / 说明" Binding="{Binding State.Description}" ElementStyle="{StaticResource GridCellText}" Width="*" />
                  <DataGridTextColumn Header="所属网络" Binding="{Binding State.Pvid, StringFormat=网络 {0}}" ElementStyle="{StaticResource GridCellText}" Width="110" />
                  <DataGridTextColumn Header="当前状态" Binding="{Binding State.StatusLabel}" ElementStyle="{StaticResource GridCellText}" Width="120" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Visibility="{Binding EasyFillVisible, Converter={StaticResource BoolVisibility}}">
          <Border Style="{StaticResource Card}" Padding="16" Visibility="{Binding EasyNeedsPort, Converter={StaticResource BoolVisibility}}">
            <StackPanel><TextBlock Text="当前设置（只读，不会自动成为修改内容）" FontSize="14" Foreground="#64748B" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding EasyCurrentPorts}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Object}" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding Before}" Margin="12,0" /><TextBlock Grid.Column="2" Text="{Binding After}" Foreground="#64748B" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding EasyNameVisible, Converter={StaticResource BoolVisibility}}">
            <StackPanel><TextBlock Text="新的端口名称 / 说明" FontSize="16" FontWeight="SemiBold" /><TextBox Text="{Binding EasyName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding EasyCanEditName}" AutomationProperties.Name="新的端口名称" MaxLength="128" FontSize="16" Margin="0,12,0,10" /><TextBlock Text="例如：财务室打印机、3楼会议室。支持中文；只改名称，不改变所属网络、端口模式或启停状态。" Style="{StaticResource MutedText}" /><CheckBox Content="清空原有名称，不填写新名称" IsChecked="{Binding EasyClearName}" Margin="0,16,0,0" /></StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding EasyNetworkVisible, Converter={StaticResource BoolVisibility}}">
            <StackPanel><TextBlock Text="改到哪个网络？" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="网络用 VLAN 编号区分，请选择管理员要求的编号。此操作不会自动配置 IP、网关或 DHCP。" Style="{StaticResource MutedText}" Margin="0,10,0,8" /><CheckBox Content="现有列表里没有所需网络，我要同时创建一个新编号" IsChecked="{Binding EasyCreateNetwork}" Margin="0,8,0,8" /><Border Background="#EFF5FF" CornerRadius="8" Padding="14" Margin="0,12,0,0"><StackPanel><TextBlock Text="{Binding EasyBindingNotice}" /><CheckBox Content="保留已绑定设备，并一起迁移到新网络" IsChecked="{Binding EasyKeepBindings}" Margin="0,10,0,0" /><TextBlock Text="迁移时会短暂关闭相关端口，完成后恢复原启停状态和绑定规则。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" /></StackPanel></Border></StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding EasyChooseNetworkVisible, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="选择设备中已经存在的网络" FontSize="15" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding EasyNetworks}" SelectedItem="{Binding EasyNetwork}" DisplayMemberPath="Label" FontSize="15" AutomationProperties.Name="目标网络" Margin="0,12,0,0" /></StackPanel></Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding EasyNetworkNumberVisible, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="新网络编号（VLAN，1–4094）" FontSize="16" FontWeight="SemiBold" /><TextBox Text="{Binding EasyNetworkNumber, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left" FontSize="18" AutomationProperties.Name="新网络编号" /><TextBlock Text="请填写管理员提供的编号。软件会自动生成对应名称，例如 VLAN20。" Style="{StaticResource MutedText}" /></StackPanel></Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding EasyNetworkNameVisible, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="新的网络名称" FontSize="16" FontWeight="SemiBold" /><TextBox Text="{Binding EasyNetworkName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新的网络名称" /><TextBlock Text="为兼容已适配设备，使用英文字母、数字、下划线或短横线，例如 Office20（办公网络）。" Style="{StaticResource MutedText}" /></StackPanel></Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding EasyDeleteNetworkVisible, Converter={StaticResource BoolVisibility}}"><TextBlock Text="只有不再被端口使用的网络才能删除。默认网络、管理网络和仍有端口使用的网络都会被拦截。下一步仍会先显示确认，不会直接删除。" Foreground="#9A650D" /></Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding EasyPowerVisible, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="这些端口要改成什么状态？" FontSize="16" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding EasyPowerChoices}" SelectedItem="{Binding EasyPower}" DisplayMemberPath="Label" AutomationProperties.Name="端口打开或关闭" Margin="0,12,0,10" /><TextBlock Text="关闭端口会让连接在上面的设备断网；重新打开后，还需要网线和网络设置正常才能通信。" Style="{StaticResource MutedText}" /></StackPanel></Border>
          <StackPanel Visibility="{Binding EasyMacVisible, Converter={StaticResource BoolVisibility}}">
            <Border Style="{StaticResource Card}" Visibility="{Binding EasyOldMacVisible, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="选择原来已经绑定的设备地址" FontSize="16" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding EasyExistingMacs}" SelectedItem="{Binding EasyOldMac}" DisplayMemberPath="Label" AutomationProperties.Name="原设备地址" Margin="0,12,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding EasyNewMacVisible, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="填写新的设备网卡地址（MAC）" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="每行一个，可以粘贴多条。横线、冒号、点号会自动整理，重复地址会合并。" Style="{StaticResource MutedText}" Margin="0,10,0,0" /><TextBox Text="{Binding EasyAddresses, UpdateSourceTrigger=PropertyChanged}" Height="105" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="15" AutomationProperties.Name="新的设备MAC地址" /><TextBlock Text="{Binding EasyMacCount}" Foreground="#2563EB" /><Expander Header="设备接入规则（可按需要调整）" Margin="0,15,0,0"><StackPanel Margin="0,12,0,0"><CheckBox Content="自动把允许数量设为最终绑定地址数（默认）" IsChecked="{Binding EasyAutomaticMaximum}" /><TextBlock Text="手动填写允许设备数量（不能少于最终绑定数）" Visibility="{Binding EasyManualMaximum, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0" /><TextBox Text="{Binding EasyMaximum, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding EasyManualMaximum, Converter={StaticResource BoolVisibility}}" Width="100" HorizontalAlignment="Left" AutomationProperties.Name="允许设备数量" /><TextBlock Text="出现未允许的设备时怎么处理？" /><ComboBox ItemsSource="{Binding MacViolations}" SelectedItem="{Binding EasyViolation}" DisplayMemberPath="Label" /><TextBlock Text="默认关闭整个违规端口；如果希望仅拦截陌生设备报文，可选择 restrict 或 protect。手动数量留有空位时，交换机可能动态学习其他地址。" Style="{StaticResource MutedText}" FontSize="12" /></StackPanel></Expander></StackPanel></Border>
          </StackPanel>
          <Border Style="{StaticResource Card}" Visibility="{Binding EasyBackupVisible, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="把当前配置保存为一份备份" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="备份只读取设备信息，不改变联网设置。副本保存在本机加密工作区，可在“备份与操作记录”查看；备份不等于已经支持一键恢复。" Style="{StaticResource MutedText}" Margin="0,12,0,0" /></StackPanel></Border>
        </StackPanel>
        <StackPanel Visibility="{Binding EasyReviewVisible, Converter={StaticResource BoolVisibility}}">
          <Border Background="#EFF5FF" BorderBrush="#D0DFF7" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="{Binding EasyReviewSummary}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="软件会先备份，执行后重新读取检查，再保存到交换机启动配置。其他操作和批量草稿不会混入本次执行。" Style="{StaticResource MutedText}" Margin="0,10,0,0" /></StackPanel></Border>
          <ItemsControl ItemsSource="{Binding EasyReviewRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Object}" FontWeight="SemiBold" /><TextBlock Text="{Binding Before, StringFormat=现在：{0}}" Foreground="#64748B" Margin="0,7,0,0" /><TextBlock Text="{Binding After, StringFormat=改成：{0}}" Foreground="#1D4ED8" Margin="0,7,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="{Binding PlanRisks}" Foreground="#9A650D" Margin="0,12,0,12" />
          <Expander Header="查看将发送给交换机的命令（含中文解释）"><DataGrid ItemsSource="{Binding PlanCommandRows}" MaxHeight="260" RowHeight="NaN"><DataGrid.Columns><DataGridTextColumn Header="英文命令" Binding="{Binding Command, Mode=OneWay}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontFamily" Value="Consolas" /><Setter Property="Margin" Value="8" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="中文解释" Binding="{Binding Explanation, Mode=OneWay}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="8" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Expander>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="24" Visibility="{Binding EasyResultVisible, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding EasyResult}" FontSize="18" Foreground="{Binding EasyResultColor}" /><TextBlock Text="没有一键自动回滚。若提示部分生效或保存未确认，请重新读取设备并核对记录，再决定下一步。" Style="{StaticResource MutedText}" Margin="0,16,0,0" Visibility="{Binding EasyResultWarning, Converter={StaticResource BoolVisibility}}" /><WrapPanel Margin="0,22,0,0"><Button Content="{Binding EasyAgainLabel}" Command="{Binding EasyAgain}" /><Button Content="返回操作菜单" Command="{Binding ExitEasy}" Style="{StaticResource Primary}" /></WrapPanel></StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="White" BorderBrush="#D5DEEB" BorderThickness="0,1,0,0" Padding="18,14" Margin="0,12,0,0">
      <StackPanel>
        <StackPanel Visibility="{Binding EasyReviewVisible, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12"><CheckBox Content="我已核对设备、端口和上面的改动" IsChecked="{Binding PlanConfirmed}" /><CheckBox Content="我了解这是实验性真实设备配置，已准备好连接中断时的恢复途径" IsChecked="{Binding LiveRiskAccepted}" Visibility="{Binding IsLivePlan, Converter={StaticResource BoolVisibility}}" /></StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="确认修改并检查结果" Command="{Binding ApplyPlan}" Style="{StaticResource Primary}" Margin="16,0,0,0" Visibility="{Binding EasyReviewVisible, Converter={StaticResource BoolVisibility}}" /><Button x:Name="NextStepButton" DockPanel.Dock="Right" Content="{Binding EasyNextLabel}" Command="{Binding EasyNext}" Style="{StaticResource Primary}" Margin="16,0,0,0" Visibility="{Binding EasyShowNext, Converter={StaticResource BoolVisibility}}" /><Button DockPanel.Dock="Left" Content="{Binding EasyBackLabel}" Command="{Binding EasyBack}" Margin="0,0,16,0" Visibility="{Binding EasyShowBack, Converter={StaticResource BoolVisibility}}" /><StackPanel><TextBlock Text="{Binding Operation}" Foreground="#2563EB" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" /><TextBlock Text="{Binding EasyHint}" Style="{StaticResource MutedText}" FontSize="12" /></StackPanel></DockPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
